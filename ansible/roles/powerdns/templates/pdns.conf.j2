# PowerDNS Authoritative Server Configuration

# Backend configuration
launch=gsqlite3
gsqlite3-database=/var/lib/powerdns/pdns.sqlite3
gsqlite3-dnssec

# Network binding - bind to public IP and Tailscale IP (avoid systemd-resolved conflict)
# PowerDNS needs to listen on Tailscale IP (100.64.0.3) to receive NOTIFY from cluster
local-address={{ powerdns_dns_bind_address }},100.64.0.3
# Query source - let kernel routing choose source IP (for Tailscale AXFR)
query-local-address=0.0.0.0

# Web Server configuration
webserver=yes
webserver-address=0.0.0.0
webserver-port={{ powerdns_webserver_port }}
webserver-allow-from=0.0.0.0/0

# API configuration
api=yes
api-key={{ powerdns_api_key }}

# DNS Update configuration
dnsupdate=yes
allow-dnsupdate-from={{ powerdns_allow_dnsupdate_from | default('127.0.0.1,172.16.0.0/12') }}

# Logging
loglevel=9
log-dns-queries=yes
log-dns-details=yes

# Secondary/AXFR Configuration
secondary=yes
secondary-check-signature-freshness=yes
axfr-fetch-timeout=30
# XFR cycle interval - how often secondaries check SOA for updates (default: 60)
# Combined with cluster's SOA refresh=300s, enables ~5 minute DNS propagation
xfr-cycle-interval=60
{% if powerdns_allow_notify_from is defined %}
# Allow NOTIFY from specified networks
allow-notify-from={{ powerdns_allow_notify_from }}
{% endif %}
