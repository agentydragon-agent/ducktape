services:
  powerdns:
    image: powerdns/pdns-auth-master:latest
    container_name: powerdns
    volumes:
      - ./sqlite-data:/var/lib/powerdns
      - ./config/pdns.conf:/etc/powerdns/pdns.conf:ro
    ports:
      - "{{ powerdns_dns_bind_address }}:53:53/tcp"
      - "{{ powerdns_dns_bind_address }}:53:53/udp"
      - "127.0.0.1:{{ powerdns_webserver_port }}:{{ powerdns_webserver_port }}"
    restart: unless-stopped
