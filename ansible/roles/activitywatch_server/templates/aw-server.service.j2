# vim: ft=systemd

[Unit]
Description=ActivityWatch server (Rust, headless)
After=network.target

[Service]
# $HOME already points at {{ activitywatch_server_data_dir }}
ExecStart=/opt/activitywatch/aw-server-rust/aw-server-rust \
         --host {{ activitywatch_server_host }} \
         --port {{ activitywatch_server_port }} \
         --dbpath {{ activitywatch_server_data_dir }}/aw-server.sqlite
WorkingDirectory={{ activitywatch_server_data_dir }}
User=aw-server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
