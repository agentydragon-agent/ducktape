server {
    listen 80;
    server_name {{ webhook_inbox_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ webhook_inbox_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ webhook_inbox_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ webhook_inbox_domain }}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:{{ webhook_inbox_host_port }}/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
