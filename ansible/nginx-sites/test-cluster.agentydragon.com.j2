# Stream-level SNI passthrough for cluster on port 8443
# HTTP redirect to HTTPS on port 8443 for cluster subdomains

# Redirect HTTP to HTTPS on port 8443 for all cluster subdomains
server {
    listen 80;
    server_name *.test-cluster.agentydragon.com;
    return 301 https://$host:8443$request_uri;
}