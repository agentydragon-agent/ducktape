# Based on https://github.com/inventree/InvenTree/blob/master/contrib/container/nginx.conf

server {
    # TODO: make HTTPS work
    listen 80;
    server_name inventree.agentydragon.com;

    real_ip_header proxy_protocol;

    location / {
        proxy_pass http://localhost:8189;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CLIENT_IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-By $server_addr:$server_port;

	proxy_pass_request_headers on;
	proxy_redirect off;

	client_max_body_size 100M;

	proxy_buffering off;
	proxy_request_buffering off;
    }

    # TODO: add /static/, /media/, /auth API endpoint
}
