# InvenTree environment variables for docker compose deployment

# Location of external data volume
# By default, placed in local directory 'inventree-data'
INVENTREE_EXT_VOLUME=/srv/inventree/data

# Debug: anything *non-empty* counts as "true"!
# INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=WARNING

# INVENTREE_DEBUG=True
# INVENTREE_LOG_LEVEL=DEBUG
# INVENTREE_DB_LOGGING=True
### needs some extra pip package :(
## INVENTREE_DEBUG_QUERYCOUNT=True

# InvenTree admin account
# Un-comment (and complete) these to auto-create an admin acount
# INVENTREE_ADMIN_USER=
# INVENTREE_ADMIN_PASSWORD=
# INVENTREE_ADMIN_EMAIL=

# Database configuration options
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432

# Database credentials - should be changed from the default values!
INVENTREE_DB_USER=pguser
INVENTREE_DB_PASSWORD=pgpassword

# Redis cache setup (disabled by default; comment out to diable)
# Refer to settings.py for other cache options
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

# Options for gunicorn server
INVENTREE_GUNICORN_TIMEOUT=90

# Enable custom plugins?
INVENTREE_PLUGINS_ENABLED=True

# Run migrations automatically?
INVENTREE_AUTO_UPDATE=True

# Image tag that should be used
INVENTREE_TAG=stable

# Overwrite inventree server to 8000
INVENTREE_SERVER_HTTP_PORT=8189

COMPOSE_PROJECT_NAME=inventree

INVENTREE_HTTP_PORT=12772
INVENTREE_HTTPS_PORT=12773

INVENTREE_TIMEZONE=America/Los_Angeles

# "Cookie “csrftoken” rejected because it has the “SameSite=None” attribute but is
# missing the “secure” attribute."
# (With INVENTREE_COOKIE_SAMESITE, we could also have this be False.)
INVENTREE_SESSION_COOKIE_SECURE=True
INVENTREE_SITE_URL=https://inventree.agentydragon.com

## to tell django when to set secure cookies
#SECURE_PROXY_SSL_HEADER=('HTTP_X_FORWARDED_PROTO', 'https')

# NOTE: INVENTREE_COOKIE_SAMESITE=None leads to Django never correctly
# sending Secure with its CSRF cookie which means at least Firefox will
# reject the cookie.
INVENTREE_COOKIE_SAMESITE=Strict

# use content X-Forwarded-Proto to determine if request was https ->
# if should give "secure" cookie
# NOTE: not sure if this is needed, might already be the default
INVENTREE_USE_X_FORWARDED_PROTO=True
INVENTREE_X_FORWARDED_PROTO_NAME=X-Forwarded-Proto
