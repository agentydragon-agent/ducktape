load("@rules_tf//tf:def.bzl", "tf_module", "tf_providers_versions")

# Read by //haku/base:test_agent_config_ssot (SSOT drift guard).
exports_files(["main.tf"])

# The Terraform CR is suspended and this root is parked. Keep the Bazel targets
# manual while modus-agendi/anthropic-claude-managed-agents is unavailable:
# rules_tf mirrors every provider in MODULE.bazel for unrelated Terraform
# targets, so that dead upstream provider is intentionally omitted from the
# global mirror. Explicit validate/apply work needs a restored/replaced provider.
# TODO: if the cloud agent is revived, restore provider mirroring after replacing
# the provider path or retire this HCL root in favor of imperative provisioning.
tf_providers_versions(
    name = "providers",
    providers = {
        "claude-managed-agents": "modus-agendi/anthropic-claude-managed-agents:~>1.1",
        "kubernetes": "hashicorp/kubernetes:~>2.38",
    },
    tags = [
        "manual",
        "no-sandbox",
    ],
    tf_version = "1.11.2",
)

tf_module(
    name = "haku-cloud-agent",
    providers = [
        "claude-managed-agents",
        "kubernetes",
    ],
    providers_versions = ":providers",
    tags = ["manual"],
)
