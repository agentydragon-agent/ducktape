# Example Terraform variables file
# Copy this to terraform.tfvars (can be empty for defaults!)

# All values have sensible defaults - you likely don't need to change anything!

# Optional overrides (uncomment and modify if needed):
# vault_address = "https://vault.k3s.agentydragon.com"
# authentik_url = "https://auth.k3s.agentydragon.com"  
# harbor_url = "https://registry.k3s.agentydragon.com"
# harbor_admin_group = "harbor-admins"
# kubeconfig_path = "~/.kube/config"

# Full Automation Achieved:
# ✅ Vault secrets: Auto-generated and stored at kv/harbor
# ✅ Authentik API token: Auto-generated via Kubernetes
# ✅ Harbor admin password: Auto-generated 32-char secure password
# ✅ Client secret: Auto-generated 32-char secure secret (single source of truth)
# ✅ Dependencies: Terraform manages proper ordering