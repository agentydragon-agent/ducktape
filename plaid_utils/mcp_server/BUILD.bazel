load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    deps = [
        ":config",
        "//plaid_utils:client",
        "//plaid_utils:models",
        "@pypi//fastmcp",
        "@pypi//plaid_python",
        "@pypi//pydantic",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = [
        "//plaid_utils:client",
        "//plaid_utils:link_profiles",
        "//plaid_utils:link_store",
        "//plaid_utils:plaid_link",
        "//plaid_utils:secret_store",
        "//plaid_utils:sync",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "plaid_utils.mcp_server.server",
    deps = [":server"],
)

py_binary(
    name = "app_cli",
    main_module = "plaid_utils.mcp_server.app",
    deps = [":app"],
)

py_library(
    name = "sync_cli_lib",
    srcs = ["sync_cli.py"],
    deps = [":app"],
)

py_binary(
    name = "sync_cli",
    main_module = "plaid_utils.mcp_server.sync_cli",
    deps = [":sync_cli_lib"],
)

aspect_py_binary(
    name = "server_bin",
    main = "app.py",
    deps = [":app"],
)

aspect_py_binary(
    name = "sync_bin",
    main = "sync_cli.py",
    deps = [":sync_cli_lib"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "server_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["plaid-mcp-server:latest"],
)

py_image_layer(
    name = "sync_layers",
    binary = ":sync_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "sync_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("sync_bin"),
    env = py_image_env(binary_name = "sync_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":sync_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "sync_load",
    image = ":sync_image",
    repo_tags = ["plaid-mcp-sync:latest"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":config",
        ":server",
        "//plaid_utils:models",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_app",
    srcs = ["test_app.py"],
    deps = [
        ":app",
        "//plaid_utils:link_profiles",
        "//plaid_utils:link_store",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":conftest",
        "//:conftest",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)
