"""OAuth token broker — handles OAuth2 flows, stores tokens as K8s secrets."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")
load("//tools/testing:defs.bzl", "py_test")

# =============================================================================
# Library targets (one per .py file)
# =============================================================================

py_library(
    name = "provider",
    srcs = ["provider.py"],
    imports = [".."],
    deps = [
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "k8s_client",
    srcs = ["k8s_client.py"],
    imports = [".."],
    deps = [
        ":provider",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "refresh",
    srcs = ["refresh.py"],
    imports = [".."],
    deps = [
        ":k8s_client",
        ":provider",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    data = [
        "index.html.j2",
        "plaid_link.html.j2",
    ],
    imports = [".."],
    deps = [
        ":k8s_client",
        ":provider",
        ":refresh",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//jinja2",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    imports = [".."],
    deps = [
        ":app",
        ":k8s_client",
        ":provider",
        "@pypi//uvicorn",
    ],
)

# =============================================================================
# Binary target
# =============================================================================

py_binary(
    name = "oauth_broker",
    imports = [".."],
    main_module = "oauth_broker.cli",
    deps = [":cli"],
)

# =============================================================================
# OCI Image
# =============================================================================

aspect_py_binary(
    name = "oauth_broker_bin",
    imports = [".."],
    main = "cli.py",
    deps = [":cli"],
)

py_image_layer(
    name = "layers",
    binary = ":oauth_broker_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("oauth_broker_bin"),
    env = py_image_env(binary_name = "oauth_broker_bin"),
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["oauth-broker:latest"],
)

# =============================================================================
# Tests
# =============================================================================

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = [".."],
)

py_test(
    name = "test_provider",
    srcs = ["test_provider.py"],
    imports = [".."],
    deps = [
        ":conftest",
        ":provider",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//respx",
    ],
)

py_test(
    name = "test_refresh",
    srcs = ["test_refresh.py"],
    imports = [".."],
    deps = [
        ":conftest",
        ":provider",
        ":refresh",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)
