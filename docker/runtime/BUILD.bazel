"""Runtime Docker image - shared by runtime exec and policy-eval."""

load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Combined runtime binary with all packages
py_binary(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        "//adgn:adgn",
        "//agent_core:agent_core",
        "//agent_pkg/runtime:agent_pkg_runtime",
        "//agent_server:agent_server",
        "//cli_util:cli_util",
        "//mcp_infra:mcp_infra",
        "//net_util:net_util",
        "//openai_utils:openai_utils",
    ],
)

pkg_tar(
    name = "runtime_tar",
    srcs = [":runtime"],
    include_runfiles = True,
    package_dir = "/opt/adgn",
    strip_prefix = ".",
)

pkg_tar(
    name = "entrypoint_tar",
    srcs = ["entrypoint.sh"],
    package_dir = "/usr/local/bin",
    mode = "0755",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    tars = [
        ":runtime_tar",
        ":entrypoint_tar",
    ],
    entrypoint = ["/usr/local/bin/entrypoint.sh"],
    workdir = "/opt/adgn",
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-runtime:latest"],
)
