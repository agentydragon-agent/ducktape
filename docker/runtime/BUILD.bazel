"""Runtime Docker image - shared by runtime exec and policy-eval."""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")

# Combined runtime binary with all packages
py_binary(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        "//adgn",
        "//agent_core",
        "//agent_pkg/runtime",
        "//agent_server",
        "//cli_util",
        "//mcp_infra",
        "//net_util",
        "//openai_utils",
    ],
)

pkg_tar(
    name = "runtime_tar",
    srcs = [":runtime"],
    include_runfiles = True,
    package_dir = "/opt/adgn",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    entrypoint = ["/opt/adgn/runtime"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [":runtime_tar"],
    workdir = "/opt/adgn",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-runtime:latest"],
)
