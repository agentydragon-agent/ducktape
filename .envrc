# Nix packages for repo-wide tooling
use nix -p pre-commit alejandra

# Load devenv (manages Python + uv sync for workspace)
eval "$(devenv direnvrc)"
watch_file uv.lock pyproject.toml devenv.nix
use devenv

# Activate the workspace venv (devenv creates it at .devenv/state/venv)
export VIRTUAL_ENV="$PWD/.devenv/state/venv"
PATH_add "$VIRTUAL_ENV/bin"
