# Standard Python virtualenv managed by direnv (.direnv/)
# Uses the system python3 to create/activate venv automatically
layout python python3

# Ensure test/dev tooling available for adgn_llm tasks
# Install test extras if missing (idempotent on repeated loads)
if command -v python >/dev/null 2>&1; then
  PYTEST_OK=$(python -c 'import importlib.util; import sys; sys.exit(0 if importlib.util.find_spec("pytest") else 1)' >/dev/null 2>&1 && echo 1 || echo 0)
  if [ "$PYTEST_OK" = "0" ]; then
    echo "[direnv] Installing adgn-llm test extras into direnv venv..."
    # Prefer uv if available; fallback to pip
    if command -v uv >/dev/null 2>&1; then
      uv pip install -e "llm/adgn_llm[test]"
    else
      python -m pip install -e "llm/adgn_llm[test]"
    fi
  fi
fi
