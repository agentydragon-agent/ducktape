load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "agent_core",
    srcs = glob(["src/agent_core/**/*.py"]),
    imports = ["src"],
    data = ["src/agent_core/compaction_prompt.md"],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils:openai_utils",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//pyhamcrest",
        "@pypi//rich",
        "@pypi//structlog",
    ],
)

py_test(
    name = "test_agent_core",
    srcs = glob(["tests/**/*.py"]),
    deps = [
        ":agent_core",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)
