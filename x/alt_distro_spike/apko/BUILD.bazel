# Demonstration of rules_apko integration with rules_oci.
#
# This shows how apko-built base images can be used as bases for
# Bazel-assembled application images (layering Python code on top).
#
# NOTE: This is a spike — these targets won't build without adding
# rules_apko to MODULE.bazel first.

load("@rules_apko//apko:defs.bzl", "apko_image", "apko_lock")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

# --- E2E Test Image (fully apko-built) ---

# Step 1: Generate/update lockfile from the apko config.
# Run: bazel run //x/alt_distro_spike/apko:e2e_test_lock
apko_lock(
    name = "e2e_test_lock",
    config = "e2e_test.apko.yaml",
)

# Step 2: Build the OCI image from locked packages.
apko_image(
    name = "e2e_test_base",
    config = "e2e_test.apko.yaml",
    lock = "e2e_test.apko.lock.json",  # Generated by apko_lock
    tag = "e2e-test:latest",
)

# --- Python App Image (apko base + Bazel app layers) ---

apko_lock(
    name = "python_app_lock",
    config = "python_app.apko.yaml",
)

apko_image(
    name = "python_app_base",
    config = "python_app.apko.yaml",
    lock = "python_app.apko.lock.json",
    tag = "python-app-base:latest",
)

# Layer application code on top of the apko base.
# This is where rules_oci and aspect_rules_py come in.
#
# In a real target, you'd do:
#
#   load("@aspect_rules_py//py:defs.bzl", "py_image_layer")
#
#   py_image_layer(
#       name = "app_layer",
#       binary = "//ember:emberd",
#   )
#
#   oci_image(
#       name = "ember_image",
#       base = ":python_app_base",
#       tars = [":app_layer"],
#   )
#
# The key insight: apko provides the system packages (Python runtime,
# curl, git, CA certs), and Bazel provides the application code as
# separate layers. System package layer rarely changes, app layer
# changes on every code edit.

oci_image(
    name = "python_app_image",
    base = ":python_app_base",
    # tars = [":app_layer"],  # Would reference py_image_layer
)

oci_load(
    name = "load_python_app",
    image = ":python_app_image",
    repo_tags = ["python-app:latest"],
)
