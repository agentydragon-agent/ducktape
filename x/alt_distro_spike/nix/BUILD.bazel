# Nix-built container images consumed by Bazel.
#
# The recommended pattern is:
# 1. CI builds images with `nix build .#<image>` and pushes to registry
# 2. Bazel pulls by digest via oci.pull() in MODULE.bazel
# 3. Application layers are added via rules_oci as usual
#
# This BUILD file shows both:
# - How to consume Nix-built images already in a registry
# - How to invoke nix build from a genrule (not recommended for production)

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

# ============================================================================
# Recommended: Pull Nix-built image by digest from registry
# ============================================================================
#
# In MODULE.bazel, add:
#
#   oci.pull(
#       name = "nix_rbe_worker",
#       digest = "sha256:<digest-after-push>",
#       image = "ghcr.io/agentydragon/nix-rbe-worker",
#       platforms = ["linux/amd64"],
#   )
#
# Then use it as a base:
#
#   oci_image(
#       name = "rbe_worker_with_extras",
#       base = "@nix_rbe_worker",
#       tars = [":dockerd_wrapper_layer"],
#   )
#
# CI workflow (GitHub Actions):
#
#   - name: Build RBE worker image
#     run: nix build .#rbe-worker-image
#
#   - name: Push to GHCR
#     run: |
#       skopeo copy \
#         nix:./result \
#         docker://ghcr.io/agentydragon/nix-rbe-worker:latest
#
#   - name: Get digest
#     run: |
#       skopeo inspect docker://ghcr.io/agentydragon/nix-rbe-worker:latest \
#         | jq -r '.Digest'

