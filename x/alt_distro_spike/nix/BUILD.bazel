#         "no-sandbox",
#         "local",
#         "no-remote",
#         "requires-nix",
#     ],
#     local = True,
# )

# Placeholder target so the BUILD file is valid
filegroup(
    name = "nix_spike",
    srcs = [
        "README.md",
        "flake.nix",
        "rbe-worker.nix",
    ],
)
