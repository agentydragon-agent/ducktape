# =============================================================================
# Per-package access example
#
# rules_distroless resolves transitive deps and creates per-package repos.
# You can reference individual packages for fine-grained layering:
#
#   @bookworm_e2e//git:data         — just the git package files
#   @bookworm_e2e//git:control      — package metadata
#   @bookworm_e2e//:flat            — ALL packages as a single tar
#
# Fine-grained layering example (NOT using :flat):
#
#   oci_image(
#       name = "layered_image",
#       tars = [
#           "@bookworm_e2e//base-files:data",   # Layer 1: base
#           "@bookworm_e2e//libc6:data",         # Layer 2: glibc
#           "@bookworm_e2e//git:data",           # Layer 3: git
#           ":app_layer",                         # Layer 4: application
#       ],
#   )
#
# Trade-offs:
#   :flat   — simple, one layer, rebuilds everything on any package change
#   per-pkg — more layers, better cache reuse, but more targets to manage
#             and OCI layer count limits apply (~128 layers max)
# =============================================================================
