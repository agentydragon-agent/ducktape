load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "protocol_proto",
    srcs = ["protocol.proto"],
)

py_proto_library(
    name = "protocol_py_proto",
    deps = [":protocol_proto"],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    deps = [
        ":protocol_py_proto",  # keep: dynamically imported generated module
        "//x/agentplane/native/claude:driver",
        "//x/agentplane/native/claude:scenarios",
        "//x/agentplane/native/codex:driver",
        "//x/agentplane/native/codex:scenarios",
        "@pypi//grpcio",
    ],
)

py_test(
    name = "test_protocol",
    timeout = "moderate",
    srcs = ["test_protocol.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",
        "@claude_code_cli_linux_x64//:claude",
    ],
    deps = [
        ":protocol_py_proto",  # keep: dynamically imported generated module
        ":runner",
        "//:conftest",
        "//util/bazel:runfiles",
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/harness_tests/claude:anthropic_sse",
        "//x/agentplane/harness_tests/claude:harness",
        "//x/agentplane/harness_tests/claude:requests",
        "//x/agentplane/harness_tests/codex:harness",
        "//x/agentplane/harness_tests/codex:requests",
        "//x/agentplane/harness_tests/codex:responses_sse",
        "//x/agentplane/native:process",
        "@pypi//grpcio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
