load("@rules_python//python:defs.bzl", "py_test")
load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "driver",
    srcs = ["driver.py"],
    visibility = ["//x/agentplane/capture:__subpackages__"],
)

py_library(
    name = "replay_assertions",
    testonly = True,
    srcs = ["replay_assertions.py"],
    deps = [
        "//x/agentplane/capture:replay",
        "//x/agentplane/capture/providers/codex:driver",
    ],
)

py_library(
    name = "replay_fixtures",
    testonly = True,
    srcs = ["replay_fixtures.py"],
    deps = [
        "//util/bazel:runfiles",
        "//x/agentplane/capture:replay",
        "//x/agentplane/capture/providers:shared_capture",
        "//x/agentplane/capture/providers/codex:scenarios",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_native_replay",
    # Native clients may wait through their own connection-recovery backoff.
    timeout = "moderate",
    srcs = ["test_native_replay.py"],
    data = [
        "//x/agentplane/capture/testdata:upstream_replay_fixtures",
        "@agentplane_codex_cli_linux_x64//:files",
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":replay_fixtures",  # keep: loaded by pytest_plugins
        "//:conftest",
        "//x/agentplane/capture:replay_fixtures",  # keep: loaded by pytest_plugins
        "//x/agentplane/capture/providers/codex:replay_assertions",
        "//x/agentplane/capture/providers/codex:scenarios",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    visibility = [
        "//x/agentplane/capture:__pkg__",
        "//x/agentplane/capture:__subpackages__",
    ],
    deps = [
        "//x/agentplane/capture/providers:shared_capture",
        "//x/agentplane/capture/providers/codex:driver",
    ],
)
