load("//devinfra/python:defs.bzl", "py_test")

py_test(
    name = "test_native_replay",
    srcs = ["test_native_replay.py"],
    data = [
        "//x/agentplane/capture/testdata:native_replay_fixtures",
        "@agentplane_codex_cli_linux_x64//:files",
        "@claude_code_cli_linux_x64//:claude",
