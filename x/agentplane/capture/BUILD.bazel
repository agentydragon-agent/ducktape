load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# These are implicit namespace packages, so Gazelle needs explicit labels for
# their dotted imports rather than deriving them from __init__.py files.
# gazelle:resolve py x.agentplane.capture.framing //x/agentplane/capture:framing
# gazelle:resolve py x.agentplane.capture.llm_recording_proxy //x/agentplane/capture:llm_recording_proxy
# gazelle:resolve py x.agentplane.capture.records //x/agentplane/capture:records
# gazelle:resolve py x.agentplane.capture.replay //x/agentplane/capture:replay
# gazelle:resolve py x.agentplane.capture.providers.shared_capture //x/agentplane/capture/providers:shared_capture
# gazelle:resolve py x.agentplane.capture.providers.claude.driver //x/agentplane/capture/providers/claude:driver
# gazelle:resolve py x.agentplane.capture.providers.claude.scenarios //x/agentplane/capture/providers/claude:scenarios
# gazelle:resolve py x.agentplane.capture.providers.codex.driver //x/agentplane/capture/providers/codex:driver
# gazelle:resolve py x.agentplane.capture.providers.codex.scenarios //x/agentplane/capture/providers/codex:scenarios

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "live_capture",
    main_module = "x.agentplane.capture.main",
    deps = [":main"],
)

test_suite(
    name = "tests",
    tests = [
        "//x/agentplane/capture/tests:test_native_replay",
        "//x/agentplane/capture/tests:test_proxy",
        "//x/agentplane/capture/tests:test_records",
        "//x/agentplane/capture/tests:test_replay",
    ],
)

py_library(
    name = "framing",
    srcs = ["framing.py"],
    visibility = ["//x/agentplane/capture:__subpackages__"],
)

py_library(
    name = "llm_recording_proxy",
    srcs = ["llm_recording_proxy.py"],
    visibility = ["//x/agentplane/capture:__subpackages__"],
    deps = ["//x/agentplane/capture:records"],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        "//x/agentplane/capture:llm_recording_proxy",
        "//x/agentplane/capture:records",
        "//x/agentplane/capture:replay",
        "//x/agentplane/capture/providers:shared_capture",
        "//x/agentplane/capture/providers/claude:scenarios",
        "//x/agentplane/capture/providers/codex:scenarios",
    ],
)

py_library(
    name = "replay",
    srcs = ["replay.py"],
    visibility = ["//x/agentplane/capture:__subpackages__"],
    deps = ["//x/agentplane/capture:records"],
)

py_library(
    name = "secret_scan",
    srcs = ["secret_scan.py"],
)

py_library(
    name = "records",
    srcs = ["records.py"],
    visibility = ["//x/agentplane/capture:__subpackages__"],
    deps = ["@pypi//pydantic"],
)
