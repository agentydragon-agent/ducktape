# Custom uv layout for direnv
layout_uv() {
    if ! has uv; then
        log_error "uv is not installed. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh"
        return 1
    fi

    local python_version="${1:-python3.12}"
    
    # Create .venv if it doesn't exist
    if [[ ! -d ".venv" ]]; then
        log_status "Creating virtual environment with uv..."
        uv venv --python "$python_version"
    fi
    
    # Activate the virtual environment
    source .venv/bin/activate
    
    # Install dependencies
    if [[ -f "pyproject.toml" ]]; then
        log_status "Installing dependencies with uv sync..."
        uv sync
    fi
}

# Use our custom uv layout
layout_uv python3.12
