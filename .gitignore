.bash_profile
.gitconfig
!claude_web_env/rootfs/root/.gitconfig
.gitmodules
.mcp.json
.profile
!claude_web_env/rootfs/root/.profile
.ripgreprc
.zprofile
.zshrc
!claude_web_env/rootfs/root/.zshrc
.claude/agents

