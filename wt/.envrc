# direnv environment for developing wt (uv-only)
# - Hard-require uv
# - Create .venv with uv
# - Editable install with test+typing extras on load

if ! command -v uv >/dev/null 2>&1; then
  echo "Error: 'uv' is required (https://github.com/astral-sh/uv). Install it and re-run 'direnv allow'." 1>&2
  exit 1
fi

# Ensure virtualenv exists and activate it
if [ ! -d .venv ]; then
  uv venv --seed .venv
fi
. .venv/bin/activate

# Re-evaluate env when deps metadata changes
watch_file pyproject.toml

# Editable install with extras (fast/cached with uv)
uv pip install -e ".[test,typing]"

