load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

js_library(
    name = "main",
    srcs = ["src/main.tsx", "src/styles.css"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "src/main.tsx",
    jsx = "automatic",
    visibility = ["//finance/plaid/spend:__pkg__"],
    deps = [":main"],
)

load("//devinfra/python:defs.bzl", "py_test")

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [
        ":bundle",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    env = {"CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)"},
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//finance/plaid/spend:app",
        "//util:playwright",
        "//util/testing:asgi",
        "//util/testing:undeclared_outputs",
        "//util/testing:visual_review",
        "@pypi//fastapi",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
