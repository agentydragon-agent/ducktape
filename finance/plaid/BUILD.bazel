load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//finance/plaid:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "payloads",
    srcs = ["payloads.py"],
    visibility = ["//finance/plaid:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "pgweb",
    srcs = ["pgweb.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//agentplane/egress:rule_client",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_pgweb",
    srcs = ["test_pgweb.py"],
    deps = [
        ":pgweb",
        "//:conftest",
        "//agentplane/egress:rule_client",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
