@prefix : <https://agentydragon.solidcommunity.net/private/worthy/vocabulary.ttl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: rdf:type owl:Ontology ;
    vann:preferredNamespacePrefix "worthy" ;
    vann:preferredNamespaceURI <https://agentydragon.solidcommunity.net/private/worthy/vocabulary.ttl#> .

:datetime a owl:FunctionalProperty ;
  rdfs:label "Time the Worthy snapshot was created" ;
  rdfs:domain :Snapshot ;
  rdfs:range xsd:dateTime .

:sourceSnapshot a rdf:Property ;
  rdfs:domain :Snapshot ;
  rdfs:range :SourceSnapshot .

:SourceSnapshot a rdfs:Class ;
  rdfs:label "Worthy source snapshot" ;
  rdfs:comment "Time snapshot of a Worthy source" .

:sourceSnapshotName a owl:FunctionalProperty ;
  rdfs:domain :SourceSnapshot ;
  rdfs:range xsd:string .

:SourceType a rdfs:Class .
:HardcodedSource a :SourceType .
:MintosSource a :SourceType .
:CoinbaseSource a :SourceType .
:IBFlexSource a :SourceType .
:FtxSource a :SourceType .

:AssetType a rdfs:Class .
:CurrencyItemType a :AssetType ; rdfs:label "Currency" .
:StockItemType a :AssetType ; rdfs:label "Stock" .
:CryptoItemType a :AssetType ; rdfs:label "Crypto" .

:ConverterType a rdfs:Class .
:CurrencyLayerConverter a :ConverterType .
:AlphaVantageConverter a :ConverterType .
:CoinbaseConverter a :ConverterType .

:converterSnapshotType a owl:FunctionalProperty ;
  rdfs:domain :ConverterSnapshot ;
  # TODO: ConverterSnapshotType
  rdfs:range :ConverterType .

# TODO(agentydragon): converter snapshots also hold the params...
