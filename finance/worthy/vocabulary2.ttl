@prefix : <https://agentydragon.solidcommunity.net/private/worthy/vocabulary.ttl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: rdf:type owl:Ontology ;
    vann:preferredNamespacePrefix "worthy" ;
    vann:preferredNamespaceURI <https://agentydragon.solidcommunity.net/private/worthy/vocabulary.ttl#> .

:Denomination a rdfs:Class ;
  # TODO: rdfs:isDefinedBy <.../worthy/vocabulary.ttl> ;
  rdfs:label "Denomination" ;
  rdfs:comment "An asset denomination." .

:Currency a rdfs:Class ;
  rdfs:subClassOf :Denomination ;
  rdfs:label "Currency" ;
  rdfs:comment "Currency like US dollar, Swiss frank, etc." .

:iso4217Code a rdf:Property ;
  rdfs:range rdf:Currency ;
  # TODO: should actually be string, not language-tagged
  rdfs:domain rdfs:Literal ;
  rdfs:label "ISO 4217 code" ;
  rdfs:comment "Uniquely identifies a currency." .

:Cryptocurrency a rdfs:Class ;
  rdfs:subClassOf :Denomination ;
  rdfs:label "Cryptocurrency" ;
  rdfs:comment "Cryptocurrency like Bitcoin, Ethereum, etc." .

:unofficialCode a rdf:Property ;
  rdfs:range :Cryptocurrency ;
  # TODO: should actually be string, not language-tagged
  rdfs:domain rdfs:Literal ;
  rdfs:label "Unofficial code" ;
  rdfs:comment "See https://en.wikipedia.org/wiki/ISO_4217#Unofficial_codes_for_cryptocurrencies." .

:Security a rdfs:Class ;
  rdfs:subClassOf :Denomination ;
  rdfs:label "Security" ;
  rdfs:comment "Stocks, funds, etc." .

# TODO: functional property? but are all securities listed?
:isin a rdf:Property ;
  rdfs:range rdf:Security ;
  # TODO: should actually be string, not language-tagged
  rdfs:domain rdfs:Literal ;
  rdfs:label "ISIN" ;
  rdfs:comment "International Securities Identification Number. See https://en.wikipedia.org/wiki/International_Securities_Identification_Number, like US0378331005 for Apple stock." .

# TODO: would be nice to actually merge with everything that has an ISIN...
# but not every data source has an ISIN.
:Stock a rdfs:Class ;
  rdfs:subClassOf :Security ;
  rdfs:label "Stock" ;
  rdfs:comment "For example, Google stock (GOOG)." .

:stockSymbol a rdf:Property ;
  rdfs:range :Stock ;
  rdfs:domain rdfs:Literal ;
  rdfs:label "Stock symbol" .

:Source a rdfs:Class ;
  rdfs:label "Source" ;
  rdfs:comment "Pulls asset states." .

:sourceId a rdf:Property ;
  rdfs:range rdf:Source ;
  # TODO: should actually be string, not language-tagged
  rdfs:domain rdfs:Literal ;
  rdfs:label "Source ID" .

:Asset a rdfs:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Something valuable; has denomination and amount." .

:assetDenomination a rdfs:Property ;
  rdfs:range rdf:Asset ;
  rdfs:domain :Denomination ;
  rdfs:label "Denomination" .

:assetAmount a owl:FunctionalProperty ;
  rdfs:range rdf:Asset ;
  rdfs:domain xsd:decimal ;
  rdfs:label "Amount" .

:SourceSnapshot a rdfs:Class ;
  rdfs:label "Source snapshot" .

:snapshotSource a owl:FunctionalProperty ;
  rdfs:range :SourceSnapshot ;
  rdfs:domain :Source ;
  rdfs:label "Source for source snapshot" .

# https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/issued/
# dcterms:issued

:sourceSnapshotAsset a rdfs:Property ;
  rdfs:range :SourceSnapshot ;
  rdfs:domain :Asset ;
  rdfs:label "Asset in source snapshot" .

:ConverterSnapshot a rdfs:Class ;
  rdfs:label "Converter snapshot" .

:snapshotConverter a owl:FunctionalProperty ;
  rdfs:range :ConverterSnapshot ;
  rdfs:domain :Converter ;
  rdfs:label "Converter for converter snapshot" .

:Converter a rdfs:Class ;
  rdfs:label "Converter" ;
  rdfs:comment "Provides exchange rates." .

:converterId a rdf:Property ;
  rdfs:range rdf:Converter ;
  # TODO: should actually be string, not language-tagged
  rdfs:domain rdfs:Literal ;
  rdfs:label "Converter ID" .

# https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/issued/
# dcterms:issued

:ExchangeRate a rdfs:Class ;
  rdfs:label "Exchange rate" .

:from a owl:FunctionalProperty ;
  rdfs:range :ExchangeRate ;
  rdfs:domain :Denomination ;
  rdfs:label "From" .

:to a owl:FunctionalProperty ;
  rdfs:range :ExchangeRate ;
  rdfs:domain :Denomination ;
  rdfs:label "To" .

:rate a owl:FunctionalProperty ;
  rdfs:range :ExchangeRate ;
  rdfs:domain xsd:decimal ;
  rdfs:label "Rate (TODO explain)" .

:converterExchangeRate a rdfs:Property ;
  rdfs:range :ConverterSnapshot ;
  rdfs:domain :ExchangeRate ;
  rdfs:label "Exchange rate in converter snapshot" .

:Snapshot a rdfs:Class ;
  rdfs:label "Snapshot" .

:snapshotTotal a owl:FunctionalProperty ;
  rdfs:domain :Snapshot ;
  rdfs:range :AssetAmount .

:snapshotConverterSnapshot a rdfs:Property ;
  rdfs:domain :Snapshot ;
  rdfs:range :ConverterSnapshot .

:snapshotSourceSnapshot a rdfs:Property ;
  rdfs:domain :Snapshot ;
  rdfs:range :SourceSnapshot .
