# Inherit repo root environment
source_up
source_up

NAMESPACE="tofu-state"
SECRET_NAME="tofu-state-db-app"
# TCPRoute on cluster-gateway exposes postgres on VPS port 5432.
# *.allegedly.works wildcard DNS resolves to VPS IPs.
PG_HOST="tfstate.allegedly.works"

# Extract CNPG credentials and construct PG_CONN_STR for tofu pg backend.
_db_user=$(kubectl get secret -n "$NAMESPACE" "$SECRET_NAME" -o jsonpath='{.data.username}' 2>/dev/null | base64 -d)
_db_pass=$(kubectl get secret -n "$NAMESPACE" "$SECRET_NAME" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d)
_db_name=$(kubectl get secret -n "$NAMESPACE" "$SECRET_NAME" -o jsonpath='{.data.dbname}' 2>/dev/null | base64 -d)

if [ -n "$_db_user" ]; then
  export PG_CONN_STR="postgres://${_db_user}:${_db_pass}@${PG_HOST}:5432/${_db_name}?sslmode=require"
  echo "PG_CONN_STR configured (${PG_HOST}:5432)"
else
  echo "WARNING: Could not read tofu-state-db credentials from k8s. PG_CONN_STR not set."
fi

# Proxmox API token (same as cluster/.envrc)
export PROXMOX_VE_API_TOKEN="root@pam!tofu=$(secret-tool lookup service proxmox account root-pam-tofu 2>/dev/null)"
