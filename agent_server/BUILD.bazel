"""Agent server package."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

exports_files(["pyproject.toml"])

py_library(
    name = "agent_server",
    srcs = glob(["src/agent_server/**/*.py"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core",
        "//agent_core_testing",
        "//cli_util",
        "//mcp_infra",
        "//net_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//aiohttp",
        "@pypi//aiosqlite",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//jinja2",
        "@pypi//mautrix",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "adgn-agent-serve",
    srcs = ["src/agent_server/cli.py"],
    main = "src/agent_server/cli.py",
    deps = [":agent_server"],
)

py_binary(
    name = "agent-server-matrix-bot",
    srcs = ["src/agent_server/matrix_bot.py"],
    main = "src/agent_server/matrix_bot.py",
    deps = [":agent_server"],
)

py_binary(
    name = "agent-server-generate-frontend-code",
    srcs = ["src/agent_server/scripts/generate_frontend_code.py"],
    main = "src/agent_server/scripts/generate_frontend_code.py",
    deps = [":agent_server"],
)

py_test(
    name = "test_agent_server",
    srcs = glob(["tests/**/*.py"]),
    imports = [
        ".",
        "src",
    ],
    main = "tests/pytest_runner.py",
    deps = [
        ":agent_server",
        "//agent_server/testing",
        "@pypi//docker",
        "@pypi//playwright",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_timeout",
        "@pypi//syrupy",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":agent_server"],
)
