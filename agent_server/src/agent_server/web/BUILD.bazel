load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")

# Link npm packages from workspace pnpm-lock.yaml
npm_link_all_packages(name = "node_modules")

# Export files needed by npm_translate_lock
exports_files([
    "package.json",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
])

# Source files for the agent_server web frontend
_SRCS = glob([
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.css",
    "src/**/*.html",
    "static/**",
]) + [
    "package.json",
    "vite.config.ts",
    "vitest.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
]

