# Defaults for bb remote, shared by bbr and GitHub Actions.
# CI passes explicit resource and candidate-image overrides when needed.
remote --container_image=docker://ghcr.io/agentydragon/buildbuddy-remote-runner@sha256:9165e7710dfceae6e66079448bf54ae0bd9b2ccf62721d1fc00b2695378be277
remote --runner_exec_properties=EstimatedFreeDiskBytes=100000000000
remote --runner_exec_properties=EstimatedComputeUnits=8
remote --runner_exec_properties=workload-isolation-type=firecracker
remote --runner_exec_properties=init-dockerd=true
remote --runner_exec_properties=recycle-runner=true
remote --runner_exec_properties=remote-snapshot-save-policy=always
remote --runner_exec_properties=snapshot-read-policy=newest
remote "--runner_exec_properties=run-under=/bin/bash -c 'printf \"kvm-clock\\n\" | sudo -n tee /sys/devices/system/clocksource/clocksource0/current_clocksource >/dev/null && exec \"$@\"' --"
