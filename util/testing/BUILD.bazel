"""Testing utility libraries."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "undeclared_outputs",
    testonly = True,
    srcs = ["undeclared_outputs.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "otel_tracing",
    testonly = True,
    srcs = ["otel_tracing.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":undeclared_outputs",
        "@pypi//opentelemetry_api",
        "@pypi//opentelemetry_sdk",
        "@pypi//pytest",
    ],
)

py_library(
    name = "container_logs",
    testonly = True,
    srcs = ["container_logs.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":undeclared_outputs",
        "@pypi//testcontainers",
    ],
)

py_test(
    name = "test_container_logs",
    srcs = ["test_container_logs.py"],
    data = ["//third_party/containers:debian_slim"],
    requires_docker = True,
    deps = [
        ":container_logs",
        ":undeclared_outputs",
        "//third_party/containers:rlocations",
        "//util:oci",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
