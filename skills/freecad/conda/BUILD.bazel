load("@rules_conda//conda/environment:defs.bzl", "run_binary")

exports_files(["pixi.lock"])

# FreeCAD headless CLI binary from the conda environment.
run_binary(
    name = "freecadcmd",
    environment = "@freecad_conda//:default",
    path = "bin/freecadcmd",
    visibility = ["//skills/freecad:__subpackages__"],
)

# FreeCAD GUI binary (for Xvfb tests).
run_binary(
    name = "freecad_gui",
    environment = "@freecad_conda//:default",
    path = "bin/freecad",
    visibility = ["//skills/freecad:__subpackages__"],
)
