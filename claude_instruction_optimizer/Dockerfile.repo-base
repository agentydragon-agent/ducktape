# Generic repository base layer Dockerfile
ARG BASE_IMAGE=claude-dev:latest
ARG REPO_URL
ARG REPO_MOUNT_NAME  
ARG LOCAL_REPO_PATH

FROM ${BASE_IMAGE} as repo-base

# Clone directly into final git mount point
RUN mkdir -p /git/${REPO_MOUNT_NAME}
COPY ${LOCAL_REPO_PATH} /git/${REPO_MOUNT_NAME}/
WORKDIR /git/${REPO_MOUNT_NAME}