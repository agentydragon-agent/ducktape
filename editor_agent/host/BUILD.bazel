"""Editor agent host package."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "editor_agent",
    srcs = glob(["src/editor_agent/**/*.py"]),
    data = glob(["src/editor_agent/definition/**/*"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core",
        "//agent_pkg/host:agent_pkg_host",
        "//cli_util",
        "//editor_agent/runtime:editor_agent_runtime",
        "//mcp_infra",
        "//net_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//typer",
    ],
)

py_binary(
    name = "adgn-editor-docker",
    srcs = ["src/editor_agent/cli.py"],
    main = "src/editor_agent/cli.py",
    deps = [":editor_agent"],
)

py_test(
    name = "test_editor_agent",
    srcs = glob(["tests/**/*.py"]),
    deps = [
        ":editor_agent",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)
