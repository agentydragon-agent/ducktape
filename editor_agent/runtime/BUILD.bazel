load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/lint:linters.bzl", "ruff_test")

exports_files(["pyproject.toml"])

py_library(
    name = "editor_agent_runtime",
    srcs = glob(["src/editor_agent_runtime/**/*.py"]),
    data = glob(["src/editor_agent_runtime/**/*.md"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_pkg/runtime:agent_pkg_runtime",
        "//cli_util",
        "@pypi//typer",
    ],
)

py_binary(
    name = "editor_submit",
    srcs = ["src/editor_agent_runtime/cli.py"],
    main = "src/editor_agent_runtime/cli.py",
    deps = [":editor_agent_runtime"],
)

ruff_test(
    name = "ruff",
    srcs = [":editor_agent_runtime"],
)

# --- OCI Image ---

# Package the py_binary and its runfiles into /app
pkg_tar(
    name = "editor_submit_tar",
    srcs = [":editor_submit"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

# Wrapper script to put editor-submit on PATH
pkg_tar(
    name = "editor_submit_wrapper_tar",
    srcs = ["editor-submit"],
    package_dir = "/usr/local/bin",
    mode = "0755",
)

# Package the /init script
pkg_tar(
    name = "init_tar",
    srcs = ["//editor_agent/host:init_script"],
    package_dir = "/",
    mode = "0755",
)

# OCI image combining base + Python app + init script
oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    tars = [
        ":editor_submit_tar",
        ":editor_submit_wrapper_tar",
        ":init_tar",
    ],
    entrypoint = ["/bin/sh", "-c"],
    cmd = ["sleep infinity"],
    workdir = "/workspace",
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
)

# Load image into local Docker daemon
# Run: bazel run //editor_agent/runtime:load
# For tarball: bazel build //editor_agent/runtime:load --output_groups=+tarball
oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-editor:latest"],
)
