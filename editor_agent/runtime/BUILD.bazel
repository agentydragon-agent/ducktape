load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "cli",
    srcs = ["cli.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//agent_pkg:mcp",
        "//cli_util:decorators",
        "//cli_util:logging",
        "@pypi//typer",
    ],
)

py_binary(
    name = "editor_submit",
    srcs = ["cli.py"],
    imports = ["../.."],
    main = "cli.py",
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//agent_pkg:mcp",
        "//cli_util:decorators",
        "//cli_util:logging",
        "@pypi//typer_slim",
    ],
)

# --- OCI Image ---

aspect_py_binary(
    name = "editor_submit_bin",
    imports = ["../.."],
    main = "cli.py",
    deps = [":cli"],
)

py_image_layer(
    name = "layers",
    binary = ":editor_submit_bin",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("editor_submit_bin"),
    env = py_image_env("editor_submit_bin"),
    tars = [":layers"],
    workdir = "/workspace",
)

# Load image into local Docker daemon
# Run: bazel run //editor_agent/runtime:load
# For tarball: bazel build //editor_agent/runtime:load --output_groups=+tarball
oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-editor:latest"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    visibility = ["//:__subpackages__"],
)
