load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "adgn_mcp_starter",
    srcs = glob(["adgn_mcp_starter/**/*.py"]),
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//claude_code_sdk",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//rich",
    ],
)

py_binary(
    name = "adgn-mcp-starter",
    srcs = ["adgn_mcp_starter/__main__.py"],
    main = "adgn_mcp_starter/__main__.py",
    deps = [":adgn_mcp_starter"],
)

py_test(
    name = "test_mcp_starter",
    srcs = ["test_server.py"],
    deps = [
        ":adgn_mcp_starter",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)
