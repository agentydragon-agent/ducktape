#!/bin/bash
# Spawn-graph initialization executable
# Usage: eval "$(spawn-init instance-name phase-name)"
#
# This outputs shell commands to be evaluated, setting up the environment

if [ $# -ne 2 ]; then
    echo "echo 'ERROR: Usage: eval \"\$(spawn-init instance-name phase-name)\"'" >&2
    exit 1
fi

INSTANCE="$1"
PHASE="$2"

# Output commands to be evaluated
cat << EOF
# Set spawn-graph instance and phase
export INSTANCE="$INSTANCE"
export PHASE="$PHASE"

# Create spawn-graph directory if needed
[ -d "./spawn-graph" ] || mkdir -p ./spawn-graph

# Helper functions
task_output_dir() {
    echo "spawn-graph/\${INSTANCE}/\${PHASE}/\$1/spawn-graph/\${INSTANCE}/\${PHASE}/\$1"
}

task_output_file() {
    echo "\$(task_output_dir "\$1")/OUTPUT.md"
}

task_dir() {
    echo "./spawn-graph/\${INSTANCE}/\${PHASE}/\$1"
}

assert_task_output_path() {
    local slash_count=\$(echo "\$1" | tr -cd '/' | wc -c)
    [ "\$slash_count" -eq 8 ] || { echo "ERROR: Invalid path - expected 8 slashes, got \$slash_count" >&2; return 1; }
}

echo "Spawn-graph ready: INSTANCE=\$INSTANCE, PHASE=\$PHASE"
EOF