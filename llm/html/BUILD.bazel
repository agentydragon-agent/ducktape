load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/lint:linters.bzl", "ruff_test")

exports_files(["pyproject.toml"])

py_library(
    name = "llm_html",
    srcs = glob(["llm_html/**/*.py"]),
    data = glob([
        "*.css",
        "*.html",
        "*.md",
    ]),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//anthropic",
        "@pypi//beautifulsoup4",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//jinja2",
        "@pypi//lxml",
        "@pypi//markdown",
        "@pypi//markdownify",
        "@pypi//tabulate",
        "@pypi//tiktoken",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "llm-html-server",
    srcs = ["llm_html/server.py"],
    main = "llm_html/server.py",
    deps = [":llm_html"],
)

ruff_test(
    name = "ruff",
    srcs = [":llm_html"],
)


# --- OCI Image ---

pkg_tar(
    name = "server_tar",
    srcs = [":llm-html-server"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

pkg_tar(
    name = "entrypoint_tar",
    srcs = ["entrypoint.sh"],
    package_dir = "/usr/local/bin",
    mode = "0755",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    tars = [
        ":server_tar",
        ":entrypoint_tar",
    ],
    entrypoint = ["/usr/local/bin/entrypoint.sh"],
    workdir = "/app",
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    exposed_ports = ["9000/tcp"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["llm-html:latest"],
)
