(version 1)
(deny default)

;; process and signals
(allow process*)
(allow signal (target self))

;; file read: broad for now (TODO tighten to system roots)
(allow file-read*)
(allow file* (literal "/dev/null"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* (literal "/dev/random"))
(allow file* (subpath "/dev/tty"))

;; ipc and system
(allow ipc-posix-shm)
(allow ipc-posix-sem)
(allow ipc-sysv-shm)
(allow mach-lookup)
(allow system-socket)
(allow sysctl-read)

;; network (TODO tighten to loopback only)
(allow network-outbound)
(allow network-inbound (local ip))

;; dynamic write roots
(allow file* (subpath (param "WORKSPACE")))
(allow file* (subpath (param "RUN_ROOT")))
(allow file* (subpath "/tmp"))
(allow file* (subpath "/private/tmp"))
