# direnv + devenv (cached) — recommended setup
# Caches the shell and only re-syncs Python deps when lock files change.

# Load devenv's direnv integration (provides caching + helpers)
eval "$(devenv direnvrc)"

# Trigger rebuilds only when dependency definitions change
watch_file pyproject.toml uv.lock

# Activate the devenv-provided environment (incl. Python venv managed by devenv)
use devenv

