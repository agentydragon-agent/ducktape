#!/usr/bin/env python3
"""
Dump a Python repo into one text blob, skipping certain files (similar to a .gitignore approach),
using a global config that can be updated to include/exclude unknown file types.

Features:
  - Loads ~/.config/repodump.yaml (must exist or script exits)
  - Skips known excludes (egg-info, pycache, images, etc.)
  - Includes known code/docs (.py, .md, .rst, etc.)
  - Strips repeated text snippets anywhere in each file (literal or regex)
  - If any file isn't matched by include/exclude, it will list them and exit
  - Finally prints total size & approximate OpenAI tokens

Usage:
  repodump [OPTIONS]

Typical flow:
  1) repodump
     (if it complains about unknown files, add them in ~/.config/repodump.yaml, then rerun)
  2) repodump -o
     (dumps final output to stdout)
  3) repodump -o mydump.txt
     (writes final output to mydump.txt)
  4) repodump -o mydump.txt -c
     (writes final output to file and copies to clipboard)
"""

import os
import sys
import fnmatch
import re

import yaml  # pip install pyyaml
import click  # pip install click

CONFIG_PATH = os.path.expanduser("~/.config/repodump.yaml")

DEFAULT_CONFIG = {
    "repos": {},
    "global": {
        "include": [
            "*.py",
            "*.md",
            "*.rst",
            # etc.
        ],
        "exclude": [
            "*.egg-info*",
            "*__pycache__*",
            "*.mo",
            "*.po",
            "*LC_MESSAGES*",
            "*fonts*",
            "*.jpg",
            "*.jpeg",
            "*.png",
            "*.gif",
            "*.webp",
            "*.ico",
            "*.svg",
            # etc.
        ],
    },
}


def load_config():
    """Load YAML config from ~/.config/repodump.yaml or exit if missing."""
    if not os.path.isfile(CONFIG_PATH):
        click.echo(f"Config not found: {CONFIG_PATH}\nPlease create it, then re-run.")
        sys.exit(1)
    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def pattern_match(path, patterns):
    """Return True if 'path' matches any pattern in 'patterns' (fnmatch)."""
    return any(fnmatch.fnmatch(path, p) for p in patterns)


def scan_directory(root_dir, cfg_includes, cfg_excludes):
    """
    Recursively gather text from files that match 'include' but not 'exclude',
    using relative paths from 'root_dir' for matching.
    Track any unknown files not matched by either.
    Returns: (all_files, uncertain_files).
    """
    all_files = []
    uncertain_files = []

    for dirpath, dirnames, filenames in os.walk(root_dir):
        rel_dir = os.path.relpath(dirpath, root_dir)
        if rel_dir == ".":
            rel_dir = ""

        # If the directory itself is excluded, skip recursing
        if rel_dir and pattern_match(rel_dir, cfg_excludes):
            dirnames[:] = []
            continue

        for f in filenames:
            rel_file = os.path.join(rel_dir, f) if rel_dir else f

            if pattern_match(rel_file, cfg_includes):
                all_files.append(os.path.join(dirpath, f))
            elif pattern_match(rel_file, cfg_excludes):
                continue
            else:
                # Not matched by either => uncertain
                uncertain_files.append(rel_file)

    return all_files, sorted(set(uncertain_files))


def approximate_tokens(byte_count):
    """Roughly estimate tokens from bytes (1 token ~ 4 chars)."""
    return byte_count // 4


def strip_snippets_from_text(text, snippets):
    """
    snippets is a list of dicts, each dict might have:
      - type: one of ["literal", "regex"]
      - lines: str (for literal)
      - pattern: str (for regex)
      - flags: optional string describing re flags (e.g. "IGNORECASE|MULTILINE")

    We remove each snippet from 'text':
      - "literal": remove every occurrence of snippet['lines']
      - "regex": re.sub snippet['pattern'] with ''
    """
    for snip in snippets:
        stype = snip.get("type")
        if stype == "literal":
            text = remove_literal(text, snip.get("lines", ""))
        elif stype == "regex":
            text = remove_regex(text, snip.get("pattern", ""), snip.get("flags", ""))
        else:
            pass  # unknown snippet type
    return text


def remove_literal(text, snippet):
    """Remove all occurrences of 'snippet' from text."""
    if not snippet:
        return text
    return text.replace(snippet, "")


def remove_regex(text, pattern, flags_str):
    """Remove all matches of 'pattern' from text. 'flags_str' e.g. 'IGNORECASE|MULTILINE'."""
    combined_flags = 0
    for f in flags_str.split("|"):
        f = f.strip().upper()
        if hasattr(re, f):
            combined_flags |= getattr(re, f)

    return re.sub(pattern, "", text, flags=combined_flags)


@click.command()
@click.option(
    "--output",
    "-o",
    "output_file",
    required=False,
    default=None,
    type=click.Path(writable=True, dir_okay=False, allow_dash=True),
    flag_value="",  # if user specifies -o with no file => ""
    nargs=1,        # allow a single optional argument
    help=(
        "If omitted, no direct dump.\n"
        "If used alone (`-o`), dump to stdout.\n"
        "If used with an argument (`-o file`), write to that file."
    ),
)
@click.option(
    "--copy",
    "-c",
    "copy_output",
    is_flag=True,
    help="Copy final output to clipboard (requires pyperclip)."
)
def main(output_file, copy_output):
    """
    Dump all matched repo files into a single text blob,
    optionally removing repeated snippets, and either printing or writing to file.
    """
    config = load_config()
    root_dir = os.getcwd()

    # Merge config for this repo + global
    if "repos" not in config:
        config["repos"] = {}
    if "global" not in config:
        config["global"] = DEFAULT_CONFIG["global"]

    repo_cfg = config["repos"].get(root_dir, {})
    includes = repo_cfg.get("include", []) + config["global"].get("include", [])
    excludes = repo_cfg.get("exclude", []) + config["global"].get("exclude", [])
    snippets = config.get("strip_snippets", [])  # optional snippet removal

    # Collect files
    all_files, uncertain_files = scan_directory(root_dir, includes, excludes)

    # If unknown files => show them, let user add them to config, then exit
    if uncertain_files:
        click.echo("These files are not matched by include/exclude patterns:")
        for u in uncertain_files:
            click.echo(f"  - {u}")

        click.echo(f"\nAdd them to your config in: {CONFIG_PATH}")

        if root_dir not in config["repos"]:
            config["repos"][root_dir] = {"include": [], "exclude": []}

        click.echo("\nExample snippet to add:\n")
        for u in uncertain_files:
            click.echo(f"    # - {u}")
        click.echo("\nThen rerun. Exiting now.")
        sys.exit(0)

    # Read + combine all files
    blob_lines = []
    for fp in sorted(all_files):
        try:
            with open(fp, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            # remove any snippets
            content = strip_snippets_from_text(content, snippets)
            relpath = os.path.relpath(fp, root_dir)
            blob_lines.append(f"# FILE: {relpath}\n{content}\n\n")
        except Exception:
            blob_lines.append(
                f"# Skipped unreadable file: {os.path.relpath(fp, root_dir)}\n\n"
            )

    final_text = "".join(blob_lines)
    byte_count = len(final_text.encode("utf-8"))
    token_est = approximate_tokens(byte_count)

    click.echo(f"Files included: {len(all_files)}")
    click.echo(f"Total size: {byte_count} bytes, ~{token_est} tokens.")

    # Decide how/where to output final text
    # output_file is one of:
    #   None => user didn't pass -o => print no content
    #   "" => user passed -o with no argument => print to stdout
    #   "some/path" => user passed -o some/path => write to file

    if output_file is not None:
        if output_file == "":
            # means user gave -o with no arg => print to stdout
            click.echo("=== BEGIN DUMP ===")
            click.echo(final_text, nl=False)  # avoid extra blank line at the end
            click.echo("\n=== END DUMP ===")
        else:
            # user gave a path
            outpath = os.path.abspath(output_file)
            with open(outpath, "w", encoding="utf-8") as wf:
                wf.write(final_text)
            click.echo(f"Dump written to: {outpath}")

    # If --copy was given
    if copy_output:
        try:
            import pyperclip
            pyperclip.copy(final_text)
            click.echo("Dump copied to clipboard.")
        except ImportError:
            click.echo("pyperclip not installed; cannot copy to clipboard.")


if __name__ == "__main__":
    main()

