#!/usr/bin/env python3
"""
Dump a Python repo into one text blob, skipping certain files (similar to a .gitignore approach),
using a global config that can be updated to include/exclude unknown file types.

Usage:
  repodump [--output] [--copy]

  By default:
    - Scans the current directory
    - Loads ~/.config/repodump.yaml (creates default if missing)
    - Skips known excludes (egg-info, pycache, images, fonts, translations, etc.)
    - Includes known code/docs (.py, .md, .rst, setup.py, etc.)
    - If any file isn't matched by include/exclude, it will list them and exit
    - Finally prints total size & approximate OpenAI tokens
    - If --output is given, prints the full concatenated blob to stdout
    - If --copy is given, copies that blob to clipboard (requires 'pyperclip' installed)

Example steps:
  1) repodump
     (check if it complains about unknown files, update config accordingly)
  2) repodump --output
     (now that config is set, it will dump everything to stdout)
"""

import fnmatch
import os
import re
import sys

import yaml  # pip install pyyaml

CONFIG_PATH = os.path.expanduser("~/.config/repodump.yaml")

DEFAULT_CONFIG = {
    "repos": {},
    "global": {
        "include": [
            "*.py",
            "*.md",
            "*.rst",
            # Add more as desired
        ],
        "exclude": [
            "*.egg-info*",
            "*__pycache__*",
            "*.mo",
            "*.po",
            "*LC_MESSAGES*",
            "*fonts*",
            "*.jpg",
            "*.jpeg",
            "*.png",
            "*.gif",
            "*.webp",
            "*.ico",
            "*.svg",
            # "*documentation/src/install/*",
            # etc.
        ],
    },
}


def load_config():
    if not os.path.isfile(CONFIG_PATH):
        print(f"Create a config at {CONFIG_PATH}.")
        sys.exit(1)
    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def save_config(cfg):
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        yaml.dump(cfg, f, sort_keys=False)


def pattern_match(path, patterns):
    """Return True if path matches any pattern in patterns (fnmatch)."""
    return any(fnmatch.fnmatch(path, p) for p in patterns)


def is_text_file(filename):
    """Heuristic check if it's probably text based on extension."""
    text_exts = [
        ".py",
        ".md",
        ".rst",
        ".txt",
        ".yaml",
        ".yml",
        ".json",
        ".toml",
        ".cfg",
        ".ini",
        ".license",
        ".html",
    ]
    lower_name = filename.lower()
    return any(lower_name.endswith(ext) for ext in text_exts)


def scan_directory(root_dir, cfg_includes, cfg_excludes):
    """
    Recursively gather text from files that match 'include' but not 'exclude',
    using relative paths from 'root_dir' for matching.
    Also track any unknown files if they're not matched by either.
    """
    all_files = []
    uncertain_files = []

    for dirpath, dirnames, filenames in os.walk(root_dir):
        rel_dir = os.path.relpath(dirpath, root_dir)
        if rel_dir == ".":
            rel_dir = ""

        # Check if directory is excluded by relative path
        if rel_dir and pattern_match(rel_dir, cfg_excludes):
            # Exclude this directory and all subdirectories
            dirnames[:] = []
            continue

        # For each file in dirpath:
        for f in filenames:
            rel_file = os.path.join(rel_dir, f) if rel_dir else f

            # Include?
            if pattern_match(rel_file, cfg_includes):
                all_files.append(os.path.join(dirpath, f))
            # Exclude?
            elif pattern_match(rel_file, cfg_excludes):
                continue
            else:
                # Not matched by either exclude or include => uncertain
                uncertain_files.append(rel_file)

    return all_files, sorted(set(uncertain_files))


def approximate_tokens(byte_count):
    # ~4 chars per token is a rough guess
    return byte_count // 4


def main():
    config = load_config()
    root_dir = os.getcwd()

    # Load or create structure for this repo
    if "repos" not in config:
        config["repos"] = {}
    if "global" not in config:
        config["global"] = DEFAULT_CONFIG["global"]

    repo_cfg = config["repos"].get(root_dir, {})
    includes = repo_cfg.get("include", []) + config["global"].get("include", [])
    excludes = repo_cfg.get("exclude", []) + config["global"].get("exclude", [])

    all_files, uncertain_files = scan_directory(root_dir, includes, excludes)

    if uncertain_files:
        print("These files are not matched by include/exclude patterns:")
        for u in uncertain_files:
            print("  -", u)
        print("\nAdd them to your config in:", CONFIG_PATH)

        # If needed, pre-seed the repo config block so user can edit
        if root_dir not in config["repos"]:
            config["repos"][root_dir] = {"include": [], "exclude": []}

        print("\nExample snippet to add:\n")
        for u in uncertain_files:
            print(f"    # - {u}")
        print("")
        print("Then rerun. Exiting now.")
        return

    # If here, all files are matched => let's load them
    blob_lines = []
    for fp in sorted(all_files):
        try:
            with open(fp, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()

            # Apply any pattern stripping rules.
            snippets = config.get("strip_snippets", [])
            content = strip_snippets_from_text(content, snippets)

            blob_lines.append(f"# FILE: {os.path.relpath(fp, root_dir)}\n{content}\n\n")
        except Exception:
            blob_lines.append(
                f"# Skipped unreadable file: {os.path.relpath(fp, root_dir)}\n\n"
            )

    final_text = "".join(blob_lines)
    byte_count = len(final_text.encode("utf-8"))
    token_est = approximate_tokens(byte_count)

    print(f"Files included: {len(all_files)}")
    print(f"Total size: {byte_count} bytes, ~{token_est} tokens.")

    if "--output" in sys.argv or "-o" in sys.argv:
        print("=== BEGIN DUMP ===")
        print(final_text)
        print("=== END DUMP ===")

    if "--copy" in sys.argv or "-c" in sys.argv:
        try:
            import pyperclip
        except ImportError:
            print("pyperclip not installed, can't copy to clipboard")
            sys.exit(1)

        pyperclip.copy(final_text)
        print("Dump copied to clipboard")


def strip_snippets_from_text(text, snippets):
    """
    snippets is a list of dicts, each dict might have:
      - type: one of ["literal", "literal_top", "regex"]
      - lines: str (for literal_top)
      - pattern: str (for regex)
      - flags: optional string describing re flags (e.g. "IGNORECASE|MULTILINE")

    Returns text with each snippet removed accordingly.
    """
    # Process each snippet in turn
    for snip in snippets:
        stype = snip.get("type")
        if stype == "literal_top":
            text = remove_literal_top(text, snip["lines"])
        if stype == "literal":
            text = remove_literal(text, snip["lines"])
        elif stype == "regex":
            text = remove_regex(text, snip["pattern"], snip.get("flags", ""))
        else:
            # unrecognized snippet type
            pass
    return text


def remove_literal(text, snippet):
    """Remove 'snippet'."""
    return text.replace(snippet, "")


def remove_literal_top(text, snippet):
    """
    Remove 'snippet' if it matches *exactly* from line 0 onward,
    ignoring any trailing blank lines in snippet or text.
    """
    # Convert to list of lines
    file_lines = text.splitlines()
    snippet_lines = snippet.splitlines()

    # Trim trailing blank lines from snippet
    while snippet_lines and not snippet_lines[-1].strip():
        snippet_lines.pop()

    # If the file starts exactly with snippet_lines (in order), remove them
    if file_lines[: len(snippet_lines)] == snippet_lines:
        return "\n".join(file_lines[len(snippet_lines) :])
    else:
        return text


def remove_regex(text, pattern, flags_str):
    """
    Remove all matches of 'pattern' (a regex) from text.
    'flags_str' can be "IGNORECASE|MULTILINE", etc.
    """
    # Convert flags string to actual int flags
    combined_flags = 0
    if flags_str:
        for f in flags_str.split("|"):
            f = f.strip().upper()
            if hasattr(re, f):
                combined_flags |= getattr(re, f)

    return re.sub(pattern, "", text, flags=combined_flags)


if __name__ == "__main__":
    main()
