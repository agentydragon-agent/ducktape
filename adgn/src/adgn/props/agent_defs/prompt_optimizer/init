#!/usr/bin/env python3
"""Init script for prompt optimizer agent.

Executed automatically by the runtime before agent sampling begins.
Prints environment info, documentation, and verifies resources are available.

Exit non-zero to abort agent startup (e.g., if required resources are missing).
"""

import sys

# Add workspace to path for local imports (bin/, etc.)
sys.path.insert(0, "/workspace")

from init_helpers import print_bootstrap, print_section

from adgn.props.agent_helpers import get_current_agent_run
from adgn.props.db import get_session
from adgn.props.db.models import Snapshot
from adgn.props.prompt_optimize.target_metric import TargetMetric

# Print standard bootstrap (tree, docs, env)
print_bootstrap("Prompt Optimizer", [
    # Infrastructure (how to connect)
    "database_access.md",
    "mcp_http_connection.md",
    # Domain data in topo order
    "db/examples.md",
    "db/ground_truth.md",
    "db/critiques.md",
    "db/grading.md",
    "db/evaluation_flow.md",
    "db/costs.md",
    # Task-specific context
    "critic_context.md",
    "writing_agent_definitions.md",
    # Optimization techniques
    "optimization/meta_prompting.md",
    "optimization/automatic_optimization.md",
    "optimization/anthropic_best_practices.md",
])

# Print CLI usage from bin/critic_dev module docstring
print_section("Critic Dev CLI Commands")
from bin import critic_dev  # noqa: E402

print(critic_dev.__doc__)

# Extended database verification for prompt optimizer
print_section("Database Access Verification")

with get_session() as session:
    from sqlalchemy import text

    result = session.execute(text("SELECT current_user")).scalar()
    print(f"✓ Connected as: {result}")

    count = session.query(Snapshot).count()
    print(f"✓ Database connected - {count} snapshots available")

    # Get current agent run using the typed helper (crashes if not connected as agent)
    agent_run = get_current_agent_run(session)
    print(f"✓ Agent run ID: {agent_run.agent_run_id}")

    train_count = session.query(Snapshot).filter_by(split="train").count()
    valid_count = session.query(Snapshot).filter_by(split="valid").count()
    print(f"✓ Training snapshots: {train_count}")
    print(f"✓ Validation snapshots: {valid_count}")

    # Get target metric using typed accessor
    config = agent_run.prompt_optimizer_config()
    target_metric = config.target_metric
    print(f"\n=== TARGET METRIC: {target_metric.value.upper()} ===")
    if target_metric == TargetMetric.WHOLE_REPO:
        print("Mode: Black-box validation - only whole-snapshot examples on VALID split")
        print("Query metrics via: SELECT * FROM get_validation_run_aggregates()")
    elif target_metric == TargetMetric.TARGETED:
        print("Mode: White-box iteration - per-file and whole-snapshot examples on VALID")
        print("Query metrics via: aggregated_recall_by_definition view")

print("\n=== Ready to begin prompt optimization ===\n")
