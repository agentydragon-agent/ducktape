#!/usr/bin/env python3
"""Init script for critic agent.

Executed automatically by the runtime before agent sampling begins.
Prints environment info, documentation, and verifies resources are available.

Exit non-zero to abort agent startup (e.g., if required resources are missing).
"""

from pathlib import Path
import sys

# Add workspace to path for local imports (bin/, etc.)
sys.path.insert(0, "/workspace")

from init_helpers import print_bootstrap, print_section, verify_db_access

from adgn.props.agent_helpers import get_current_agent_run
from adgn.props.db import get_session
from adgn.props.db.examples import Example
from adgn.props.models.critic_scopes import AllFilesScope, ExplicitFileScope


# Print standard bootstrap (tree, docs, env)
print_bootstrap("Critic", [
    # Infrastructure (how to connect)
    "database_access.md",
    "mcp_http_connection.md",
    # Domain data (what data exists)
    "db/critiques.md",
])

# Get review scope from database (via agent run)
with get_session() as session:
    agent_run = get_current_agent_run(session)
    config = agent_run.critic_config()
    snapshot_slug = config.snapshot_slug
    scope_hash = config.scope_hash

    # Look up the example to get the actual scope
    example = session.get(Example, (snapshot_slug, scope_hash))
    if example is None:
        print(f"ERROR: Example not found for ({snapshot_slug}, {scope_hash})", file=sys.stderr)
        sys.exit(1)
    scope = example.scope

# Print review scope
print_section("Review Scope")
print(f"Snapshot: {snapshot_slug}")
snapshot_path = Path(f"/snapshots/{snapshot_slug}")
print(f"Source code location: {snapshot_path}")

if not snapshot_path.is_dir():
    print(f"\nERROR: Snapshot directory not found or not a directory: {snapshot_path}", file=sys.stderr)
    sys.exit(1)

# Format scope for display
if isinstance(scope, AllFilesScope):
    scope_desc = "ALL files in snapshot"
elif isinstance(scope, ExplicitFileScope):
    scope_desc = ", ".join(scope.files)
else:
    raise TypeError(f"Unknown scope type: {type(scope)}")
print(f"Files to review: {scope_desc}")
print("\nTo review code, use paths like:")
print(f"  cat {snapshot_path}/<file>")
print(f"  rg -n 'pattern' {snapshot_path}/")

# Print CLI usage from bin/critique module docstring
print_section("Critic CLI Commands")
from bin import critique as critique_cli  # noqa: E402

print(critique_cli.__doc__)

# Verify database access
verify_db_access()

print("\n=== Ready to begin review ===\n")
