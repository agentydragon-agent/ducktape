#!/usr/bin/env python3
"""Init script for grader agent.

Executed automatically by the runtime before agent sampling begins.
Prints environment info and verifies resources are available.

Exit non-zero to abort agent startup (e.g., if required resources are missing).
"""

import sys

# Add workspace to path for local imports (bin/, etc.)
sys.path.insert(0, "/workspace")

from init_helpers import print_bootstrap, print_section, verify_db_access

# Print standard bootstrap (tree, docs, env)
print_bootstrap("Grader", [
    # Infrastructure (how to connect)
    "database_access.md",
    "mcp_http_connection.md",
    # Domain data in topo order
    "db/ground_truth.md",
    "db/critiques.md",
    "db/grading.md",
])

# Print CLI usage from bin/grader module docstring
print_section("Grader CLI Commands")
from bin import grader as grader_cli  # noqa: E402

print(grader_cli.__doc__)

verify_db_access()

print("\n=== Ready to begin grading ===\n")
