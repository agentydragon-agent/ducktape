+def _make_progress_logger(enabled: bool):
+    last_print_at = datetime.now(timezone.utc)
+
+    def log(msg: str) -> None:
+        nonlocal last_print_at
+        if not enabled:
+            return
+        now = datetime.now(timezone.utc)
+        if (now - last_print_at) >= PROGRESS_INTERVAL:
+            sys.stderr.write(msg + "\n")
+            sys.stderr.flush()
+            last_print_at = now
+
+    return log
+
+
