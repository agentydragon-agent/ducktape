"""ADGN - Agent framework and LLM tooling."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files(["pyproject.toml"])
py_library(
    name = "adgn",
    srcs = glob(["src/adgn/**/*.py"]),
    data = glob([
        "src/adgn/**/*.md",
        "src/adgn/**/*.j2",
        "src/adgn/**/*.json",
    ]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core",
        "//agent_pkg/host:agent_pkg_host",
        "//agent_pkg/runtime:agent_pkg_runtime",
        "//cli_util",
        "//mcp_infra",
        "//net_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//aiosqlite",
        "@pypi//anthropic",
        "@pypi//anyio",
        "@pypi//claude_code_sdk",
        "@pypi//docker",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//jinja2",
        "@pypi//mcp",
        "@pypi//openai",
        "@pypi//pandas",
        "@pypi//pathspec",
        "@pypi//platformdirs",
        "@pypi//plotnine",
        "@pypi//pydantic",
        "@pypi//pygit2",
        "@pypi//pyyaml",
        "@pypi//requests",
        "@pypi//rich",
        "@pypi//structlog",
        "@pypi//tenacity",
        "@pypi//tiktoken",
        "@pypi//typer",
        "@pypi//typer_di",
        "@pypi//unidiff",
        "@pypi//uvicorn",
    ],
)

# CLI entry points
py_binary(
    name = "adgn_agent",
    srcs = ["src/adgn/agent/cli.py"],
    main = "src/adgn/agent/cli.py",
    deps = [":adgn"],
)

py_binary(
    name = "adgn_sysrw",
    srcs = ["src/adgn/sysrw/cli.py"],
    main = "src/adgn/sysrw/cli.py",
    deps = [":adgn"],
)

py_binary(
    name = "adgn_trivial_patterns",
    srcs = ["src/adgn/tools/trivial_patterns.py"],
    main = "src/adgn/tools/trivial_patterns.py",
    deps = [":adgn"],
)

py_binary(
    name = "adgn_mcp_gitea_mirror",
    srcs = ["src/adgn/mcp/gitea_mirror/launcher.py"],
    main = "src/adgn/mcp/gitea_mirror/launcher.py",
    deps = [":adgn"],
)

py_test(
    name = "test_adgn",
    srcs = glob(["tests/**/*.py"]),
    main = "tests/util/test_unified_patch.py",
    deps = [
        ":adgn",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_env",
        "@pypi//pytest_mock",
        "@pypi//pytest_timeout",
        "@pypi//pytest_xdist",
        "@pypi//syrupy",
        "@pypi//types_docker",
        "@pypi//types_jinja2",
        "@pypi//types_pygit2",
        "@pypi//types_pyyaml",
        "@pypi//types_requests",
    ],
)
