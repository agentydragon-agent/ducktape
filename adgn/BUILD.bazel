"""ADGN - Agent framework and LLM tooling."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

exports_files([
    "devenv.nix",
])

py_library(
    name = "adgn",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            ".*/**",
            "tests/**",
        ],
    ),
    data = glob([
        "**/*.md",
        "**/*.j2",
        "**/*.json",
        "**/*.js",
    ]),
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core",
        "//agent_core_testing",
        "//agent_pkg/host",
        "//agent_pkg/runtime",
        "//cli_util",
        "//mcp_infra",
        "//net_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//aiosqlite",
        "@pypi//anthropic",
        "@pypi//anyio",
        "@pypi//claude_code_sdk",
        "@pypi//docker",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//jinja2",
        "@pypi//mcp",
        "@pypi//openai",
        "@pypi//pandas",
        "@pypi//pathspec",
        "@pypi//platformdirs",
        "@pypi//plotnine",
        "@pypi//pydantic",
        "@pypi//pygit2",
        "@pypi//pyyaml",
        "@pypi//requests",
        "@pypi//rich",
        "@pypi//structlog",
        "@pypi//tenacity",
        "@pypi//tiktoken",
        "@pypi//typer",
        "@pypi//typer_di",
        "@pypi//types_docker",
        "@pypi//types_pyyaml",
        "@pypi//types_requests",
        "@pypi//types_unidiff",
        "@pypi//unidiff",
        "@pypi//uvicorn",
    ],
)

# CLI entry points
py_binary(
    name = "adgn_agent",
    srcs = ["agent/cli.py"],
    main = "agent/cli.py",
    deps = [":adgn"],
)

py_binary(
    name = "adgn_trivial_patterns",
    srcs = ["tools/trivial_patterns.py"],
    main = "tools/trivial_patterns.py",
    deps = [":adgn"],
)

py_binary(
    name = "adgn_mcp_gitea_mirror",
    srcs = ["mcp/gitea_mirror/launcher.py"],
    main = "mcp/gitea_mirror/launcher.py",
    deps = [":adgn"],
)

py_test(
    name = "test_adgn",
    srcs = glob(["tests/**/*.py"]),
    main = "tests/util/test_unified_patch.py",
    deps = [
        ":adgn",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_env",
        "@pypi//pytest_mock",
        "@pypi//pytest_timeout",
        "@pypi//pytest_xdist",
        "@pypi//syrupy",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":adgn"],
)
