{
  "name": "Ducktape Development Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  "containerEnv": {
    "CLAUDE_HOOKS_MODE": "standard",
    "CLAUDE_HOOKS_SKIP_PROXY": "1",
    "CLAUDE_HOOKS_SKIP_BAZELISK": "1",
    "CLAUDE_HOOKS_SKIP_PODMAN": "1",
    "CLAUDE_PROJECT_DIR": "${containerWorkspaceFolder}",
    "CLAUDE_ENV_FILE": "/tmp/ducktape-env.sh"
  },
  
  "postCreateCommand": "bash .devcontainer/setup.sh",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "bazelbuild.vscode-bazel"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.mypyEnabled": true,
        "python.formatting.provider": "black"
      }
    }
  },
  
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  ],
  
  "remoteUser": "vscode"
}
