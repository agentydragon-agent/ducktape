"""Test utilities for shared testing infrastructure."""

load("@rules_python//python:defs.bzl", "py_library")

package(default_testonly = True)

py_library(
    name = "test_util",
    srcs = ["docker.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel_util:runfiles",
        "@pypi//pytest",
    ],
)

py_library(
    name = "image_loader",
    srcs = ["image_loader.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel_util:runfiles",
        "@pypi//opentelemetry_api",
    ],
)

py_library(
    name = "oci",
    srcs = ["oci.py"],
    data = ["@crane"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel_util:runfiles",
    ],
)

py_library(
    name = "undeclared_outputs",
    srcs = ["undeclared_outputs.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "playwright",
    srcs = ["playwright.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//playwright",
        "@pypi//pytest",
    ],
)
