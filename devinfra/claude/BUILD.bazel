load("//devinfra/python:defs.bzl", "py_library", "py_test")

# === Base modules (no internal deps) ===

py_library(
    name = "shell",
    srcs = ["shell.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "errors",
    srcs = ["errors.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "streaming",
    srcs = ["streaming.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "debug",
    srcs = ["debug.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "managed_files",
    srcs = ["managed_files.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "session_paths",
    srcs = ["session_paths.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//platformdirs",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    data = [
        "config/bazelrc.mako",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//platformdirs",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "sops_decrypt",
    srcs = ["sops_decrypt.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pyyaml",
    ],
)

# === Modules with internal deps ===

py_library(
    name = "env_file",
    srcs = ["env_file.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":managed_files",
        ":settings",
        "//devinfra/claude/auth_proxy:setup",
        "//util/bazel:subprocess",
    ],
)

# Packaging targets are in the root //:wheel (merged ducktape wheel).
# See /BUILD.bazel for ducktape_pkg and wheel targets.

# === Tests ===

py_library(
    name = "conftest",
    srcs = ["conftest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":session_paths",
        ":settings",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_envrc_propagation",
    srcs = ["test_envrc_propagation.py"],
    deps = [
        ":conftest",
        ":env_file",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_hook_output_serialization",
    srcs = ["test_hook_output_serialization.py"],
    deps = [
        ":conftest",
        "//devinfra/claude/claude_api/hooks:session_start",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_session_start_input",
    srcs = ["test_session_start_input.py"],
    deps = [
        ":conftest",
        "//devinfra/claude/claude_api/hooks:common",
        "//devinfra/claude/claude_api/hooks:session_start",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_sops_decrypt",
    srcs = ["test_sops_decrypt.py"],
    data = [
        "//devinfra/claude/testdata:sops_test_age_key.txt",
        "//devinfra/claude/testdata:sops_test_secrets.yaml",
        "@multitool//tools/sops",
    ],
    env = {"SOPS_BIN": "$(rlocationpath @multitool//tools/sops)"},
    deps = [
        ":sops_decrypt",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_proxy",
    srcs = ["test_proxy.py"],
    deps = [
        "//devinfra/claude/auth_proxy:credentials",
        "@pypi//pyjwt",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration",
    srcs = ["test_integration.py"],
    data = [
        "//third_party/jdk:cacerts",
        "//third_party/jdk:keytool",
    ],
    env = {
        "JAVA_CACERTS_RLOCATION": "$(rlocationpath //third_party/jdk:cacerts)",
        "KEYTOOL_RLOCATION": "$(rlocationpath //third_party/jdk:keytool)",
    },
    env_inherit = [
        "HTTPS_PROXY",
        "https_proxy",
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
    ],
    # local: keytool (Adoptium JDK) needs libjli.so which isn't on the RBE worker image
    local = True,
    tags = ["e2e"],
    deps = [
        ":conftest",
        ":session_paths",
        ":settings",
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/testing:fixtures",
        "//devinfra/claude/testing:mitmproxy_fixture",
        "@pypi//cryptography",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

