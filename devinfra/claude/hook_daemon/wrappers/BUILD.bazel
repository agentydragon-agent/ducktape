load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "install",
    srcs = ["install.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/claude:session_paths",
        "//devinfra/claude:settings",
        "//util/bazel:subprocess",
    ],
)

py_library(
    name = "bazel_lib",
    srcs = ["bazel.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/claude:debug",
        "//devinfra/claude:env_file",
        "//devinfra/claude:errors",
        "//devinfra/claude:session_paths",
        "//devinfra/claude:settings",
        "//devinfra/claude/auth_proxy:credentials",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/hook_daemon:client",
    ],
)

py_binary(
    name = "bazel",
    main_module = "devinfra.claude.hook_daemon.wrappers.bazel",
    visibility = ["//visibility:public"],
    deps = [":bazel_lib"],
)

py_library(
    name = "git_lib",
    srcs = ["git.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "git",
    main_module = "devinfra.claude.hook_daemon.wrappers.git",
    visibility = ["//visibility:public"],
    deps = [":git_lib"],
)

# === Tests ===

py_test(
    name = "test_bazel",
    srcs = ["test_bazel.py"],
    deps = [
        ":bazel_lib",
        "//devinfra/claude:conftest",
        "//devinfra/claude:errors",
        "//devinfra/claude:session_paths",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_git",
    srcs = ["test_git.py"],
    deps = [
        ":git_lib",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
