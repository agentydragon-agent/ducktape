load("//devinfra/testing:defs.bzl", "py_test")

exports_files(
    ["run_in_container.py"],
    visibility = ["//visibility:private"],
)

py_test(
    name = "test_container_e2e",
    size = "large",
    srcs = ["test_container_e2e.py"],
    data = [
        "run_in_container.py",
        "//:wheel",
        "//devinfra/claude/testdata/test_workspace:workspace_files",
        "//third_party/containers:python_3_13_slim_tarball",
    ],
    # Inherit proxy env vars so MockEgressProxy can chain through real proxy
    env_inherit = [
        "CURL_CA_BUNDLE",
        "HTTPS_PROXY",
        "https_proxy",
        "NODE_EXTRA_CA_CERTS",
        "REQUESTS_CA_BUNDLE",
        "SSL_CERT_FILE",
    ],
    imports = ["../../../.."],
    # local: needs Docker daemon access
    local = True,
    tags = [
        "e2e",
        "external",
    ],
    deps = [
        "//devinfra/claude:conftest",
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/testing:conftest",
        "//devinfra/claude/testing:mock_egress_proxy",
        "//third_party/containers:rlocations",
        "//util:net",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)
