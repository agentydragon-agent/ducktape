load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# === Base modules (no internal deps) ===

py_library(
    name = "github_actions",
    srcs = ["github_actions.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util:env",
        "@pypi//pydantic",
    ],
)

# === Library modules ===

py_library(
    name = "diff_utils",
    srcs = ["diff_utils.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        "//util/bazel:workspace",
        "@pypi//pygit2",
    ],
)

# === Exec stubs ===

py_library(
    name = "check_release",
    srcs = ["check_release.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        "//util:env",
        "//util/bazel:workspace",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "artifacts",
    srcs = ["artifacts.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util/bazel:workspace",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sync_pins",
    srcs = ["sync_pins.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        "@pypi//more_itertools",
        "@pypi//pygithub",
    ],
)

# === Binaries ===

py_binary(
    name = "sync_pins_bin",
    main_module = "devinfra.ci.sync_pins",
    deps = [":sync_pins"],
)

py_binary(
    name = "check_release_bin",
    main_module = "devinfra.ci.check_release",
    deps = [":check_release"],
)
