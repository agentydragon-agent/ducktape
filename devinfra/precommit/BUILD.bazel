load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "filename_conventions",
    srcs = ["filename_conventions.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pygit2"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pygit2",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_filename_conventions",
    srcs = ["test_filename_conventions.py"],
    deps = [
        ":conftest",
        ":filename_conventions",
        "@pypi//pygit2",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "frozen_specimens",
    srcs = ["frozen_specimens.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pygit2"],
)

py_library(
    name = "terraform_centralization",
    srcs = ["terraform_centralization.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "test_tag",
    srcs = ["test_tag.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//httpx"],
)

py_test(
    name = "test_test_tag",
    srcs = ["test_test_tag.py"],
    deps = [
        ":test_tag",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_git_hook",
    srcs = ["test_git_hook.py"],
    deps = [
        ":git_hook",
        "@pypi//pygit2",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "git_hook",
    srcs = ["git_hook.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":filename_conventions",
        ":frozen_specimens",
        ":terraform_centralization",
        ":test_tag",
        "//cluster/validation:validate_all",
        "//devinfra:pytest_main",
        "//devinfra/precommit/enforce_bazel_tests",
        "//util:otel",
        "@pypi//opentelemetry_api",
        "@pypi//opentelemetry_sdk",
        "@pypi//pygit2",
    ],
)
