@@ -0,0 +1,32 @@
+"""Response-only token metadata policy; never changes routing or the cost map."""
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+
+def project_token_limits(
+    published: Mapping[str, Any], configured: Sequence[Mapping[str, Any]]
+) -> dict[str, Any]:
+    """Opted-in deployments publish one explicit pair or no token-limit fields.
+
+    Unmarked deployments retain upstream behavior (including embeddings/audio).
+    Groups publish a pair only when every deployment opts in with the same pair;
+    mixing or independently aggregating input/output maxima would invent a contract.
+    """
+    result = dict(published)
+    result.pop("publish_token_limits", None)
+    if not any("publish_token_limits" in info for info in configured):
+        return result
+    for key in ("max_tokens", "context_window", "max_input_tokens", "max_output_tokens"):
+        result.pop(key, None)
+    pairs = []
+    for info in configured:
+        if info.get("publish_token_limits") is not True:
+            return result
+        pair = (info.get("max_input_tokens"), info.get("max_output_tokens"))
+        if not all(type(value) is int and value > 0 for value in pair):
+            return result
+        pairs.append(pair)
+    if pairs and all(pair == pairs[0] for pair in pairs):
+        result.update(max_input_tokens=pairs[0][0], max_output_tokens=pairs[0][1])
+    return result
