load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/oci:defs.bzl", "oci_image_info")

py_library(
    name = "rlocations",
    srcs = ["rlocations.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":rlocations",
        "//util:oci",
        "@pypi//pytest",
    ],
)

# Load debian-slim base image into local Docker daemon.
# Targets that need this image as a test data dep should use :image_info.
# bazel run //third_party/debian_slim:load still works for manual loading.
oci_load(
    name = "load",
    image = "@debian_slim_linux_amd64",
    repo_tags = ["debian-slim:test"],
    visibility = ["//visibility:public"],
)

oci_image_info(
    name = "image_info",
    image = "@debian_slim_linux_amd64",
    tag = "debian-slim:test",
    visibility = ["//visibility:public"],
)
