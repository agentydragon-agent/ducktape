# Pre-built container images for Testcontainers-based tests.
#
# These images are bundled as Bazel deps so hermetic tests don't need Docker Hub
# access. Test fixtures use crane to push OCI layout dirs into the Docker daemon.
#
# Usage in BUILD.bazel data deps:
#     data = ["//third_party/containers:postgres_18"]

load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/oci:defs.bzl", "oci_tarball")

package(default_testonly = True)

py_library(
    name = "rlocations",
    srcs = ["rlocations.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

oci_tarball(
    name = "postgres_18",
    image = "@postgres_18_linux_amd64",
    repo_tags = ["postgres:18"],
    visibility = ["//visibility:public"],
)

oci_tarball(
    name = "registry_2",
    image = "@registry_2_linux_amd64",
    repo_tags = ["registry:2"],
    visibility = ["//visibility:public"],
)

oci_tarball(
    name = "ryuk",
    image = "@ryuk_linux_amd64",
    repo_tags = ["testcontainers/ryuk:0.8.1"],
    visibility = ["//visibility:public"],
)

oci_tarball(
    name = "python_3_13_slim",
    image = "@python_3_13_slim_linux_amd64",
    repo_tags = ["python:3.13-slim"],
    visibility = ["//visibility:public"],
)
