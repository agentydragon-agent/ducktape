load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "webhook_inbox",
    srcs = ["webhook_inbox.py"],
    data = glob(["templates/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//compact_json",
        "@pypi//cryptography",
        "@pypi//fastapi",
        "@pypi//jinja2",
        "@pypi//starlette",
    ],
)

py_binary(
    name = "gen_key",
    srcs = ["gen_key.py"],
    deps = ["@pypi//cryptography"],
)

py_test(
    name = "test_webhook_inbox",
    srcs = ["test_webhook_inbox.py"],
    imports = ["."],
    deps = [
        ":webhook_inbox",
        "@pypi//cryptography",
        "@pypi//httpx",
        "@pypi//pytest",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":webhook_inbox"],
)
