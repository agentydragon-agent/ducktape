load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_testonly = True)

py_library(
    name = "probe",
    srcs = ["probe.py"],
    deps = [
        "//agentplane/native/codex:driver",
        "//agentplane/native/codex:scenarios",
        "//agentplane/native/codex/testing:model",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/native/testing:async_process",
        "//util:net",
        "@pypi//aiohttp",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/native/codex/testing:responses",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_probe",
    size = "medium",
    srcs = ["test_probe.py"],
    data = ["@agentplane_codex_cli_linux_x64//:files"],  # keep: real upstream harness and executor
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":conftest",
        ":probe",
        "//:conftest",
        "//agentplane/native/codex/testing:model",
        "//agentplane/native/codex/testing:model_catalog",
        "//agentplane/native/codex/testing:requests",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/native/codex/testing:responses_sse",
        "//agentplane/runner:conftest",
        "//util/bazel:runfiles",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
