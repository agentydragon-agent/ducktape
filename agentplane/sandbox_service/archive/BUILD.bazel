load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/sandbox_service:__subpackages__"])

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":db",
        "//agentplane/protocol:event_log_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/sandbox_service/archive/migrations:files"],
    deps = [
        ":db",
        "//util:db_migrations",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":database_migrate",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//asyncpg",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)

py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    deps = [
        ":conftest",
        ":store",
        "//:conftest",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/sandbox_service:conftest",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)
