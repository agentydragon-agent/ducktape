load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

# gazelle:resolve py agentplane.runner.protocol_pb2 //agentplane/runner:protocol_pb2
# gazelle:resolve py agentplane.protocol.command_pb2 //agentplane/protocol:command_pb2
# gazelle:resolve py agentplane.protocol.event_pb2 //agentplane/protocol:event_pb2
# gazelle:resolve py agentplane.protocol.event_log_pb2 //agentplane/protocol:event_log_pb2

py_library(
    name = "command_relay",
    srcs = ["command_relay.py"],
    deps = [
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/runner:conftest",
        "//agentplane/sandbox_service/testing:kubernetes",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_command_relay",
    srcs = ["test_command_relay.py"],
    deps = [
        ":command_relay",
        ":conftest",
        "//:conftest",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:protocol_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_command_relay_native",
    size = "large",
    srcs = ["test_command_relay_native.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":command_relay",
        ":conftest",
        "//:conftest",
        "//agentplane/protocol:command_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    deps = [
        ":kubernetes_grants",
        ":session_config",
        "//agentplane:subjects",
        "//agentplane/action_service/policies:resources",
        "//util:agent_sandbox",
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "kubernetes_grants",
    srcs = ["kubernetes_grants.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "session_config",
    srcs = ["session_config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_inventory",
    srcs = ["test_inventory.py"],
    deps = [
        ":conftest",
        ":inventory",
        "//:conftest",
        "//agentplane/sandbox_service/testing:kubernetes",
        "//agentplane/testing:fake_apiserver",
        "//util:agent_sandbox",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
