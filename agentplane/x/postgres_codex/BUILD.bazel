load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_testonly = True)

py_binary(
    name = "main_bin",
    main_module = "agentplane.x.postgres_codex.main",
    deps = [":main"],
)

py_test(
    name = "test_sampler",
    srcs = ["test_sampler.py"],
    data = [
        ":main_bin",
        "@agentplane_codex_cli_linux_x64//:files",
    ],
    requires_docker = True,
    deps = [
        ":code_mode",
        ":conftest",
        ":executor",
        ":sampler",
        ":store",
        ":testing",
        "//:conftest",
        "//agentplane/native/codex:wire",
        "//agentplane/native/codex/testing:harness",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/native/codex/testing:responses_sse",
        "//util/testing:sqlalchemy_engines",
        "//util/testing:undeclared_outputs",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "executor",
    srcs = ["executor.py"],
    deps = ["@pypi//aiohttp"],
)

py_library(
    name = "code_mode",
    srcs = ["code_mode.py"],
    deps = [
        ":executor",
        ":store",
    ],
)

py_library(
    name = "sampler",
    srcs = ["sampler.py"],
    deps = [
        ":code_mode",
        ":compaction",
        ":responses",
        ":store",
        "@pypi//aiohttp",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":code_mode",
        ":compaction",
        ":executor",
        ":sampler",
        ":store",
        "//util/testing:sqlalchemy_engines",
        "@pypi//aiohttp",
        "@pypi//asyncpg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":testing",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "testing",
    srcs = ["testing.py"],
    deps = [
        ":executor",
        "@pypi//aiohttp",
    ],
)

py_library(
    name = "compaction",
    srcs = ["compaction.py"],
    deps = [
        ":responses",
        ":store",
        "@pypi//aiohttp",
    ],
)

py_library(
    name = "responses",
    srcs = ["responses.py"],
    deps = [
        ":code_mode",
        "@pypi//aiohttp",
    ],
)

py_test(
    name = "test_compaction",
    srcs = ["test_compaction.py"],
    data = [
        ":main_bin",
        "@agentplane_codex_cli_linux_x64//:files",
    ],
    requires_docker = True,
    deps = [
        ":compaction",
        ":conftest",
        ":executor",
        ":sampler",
        ":store",
        "//:conftest",
        "//agentplane/native/codex/testing:responses_sse",
        "//agentplane/native/testing:model_endpoint",
        "//util/testing:sqlalchemy_engines",
        "//util/testing:undeclared_outputs",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
