load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = [
        "//agentplane/action_service:__pkg__",
        "//agentplane/app:__pkg__",
        "//agentplane/egress:__pkg__",
        "//agentplane/llm_ingress:__pkg__",
        "//agentplane/notification_service:__pkg__",
        "//agentplane/sandbox_service:__subpackages__",
    ],
)

py_library(
    name = "fake_apiserver",
    srcs = ["fake_apiserver.py"],
    deps = [
        "//agentplane:crd_group",
        "//agentplane/egress:resources",
        "//agentplane/workload_auth:principal",
        "//util:agent_sandbox",
        "@pypi//aiohttp",
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_postgres_listener",
    srcs = ["test_postgres_listener.py"],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane:postgres_listener",
        "@pypi//asyncpg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)
