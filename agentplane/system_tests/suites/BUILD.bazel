load("//agentplane/system_tests:defs.bzl", "k3s_suite")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

# Each target starts exactly one stack. Per-test clients and Sandbox cleanup remain isolated.
k3s_suite(
    name = "test_pod",
    scenarios = [
        "//agentplane/system_tests/scenarios:egress",
        "//agentplane/system_tests/scenarios:agent_messaging",
        "//agentplane/system_tests/scenarios:launch_presets",
        "//agentplane/system_tests/scenarios:session_instructions",
        "//agentplane/system_tests/scenarios:suspend_resume",
        "//agentplane/system_tests/scenarios:thread_stream",
        "//agentplane/system_tests/scenarios:runner_credentials",
        "//agentplane/system_tests/scenarios:storage",
    ],
    stack = "pod",
)

# This suite scales the Dispatcher and deletes controller Pods; it needs its own stack.
k3s_suite(
    name = "test_dispatcher",
    scenarios = ["//agentplane/system_tests/scenarios:dispatcher"],
    stack = "pod",
)

k3s_suite(
    name = "test_mcp",
    scenarios = [
        "//agentplane/system_tests/scenarios:mcp",
        "//agentplane/system_tests/scenarios:dcr",
    ],
    stack = "mcp",
)

# The groups run sequentially, preserving the validated peak of three independent VM boots.
k3s_suite(
    name = "test_vm",
    scenarios = [
        "//agentplane/system_tests/scenarios:vm_sandbox",
        "//agentplane/system_tests/scenarios:runner_credentials",
    ],
    stack = "vm",
)

k3s_suite(
    name = "test_vm_systemd",
    scenarios = ["//agentplane/system_tests/scenarios:runner_systemd"],
    stack = "vm_systemd",
)

k3s_suite(
    name = "test_sampler_pod",
    scenarios = ["//agentplane/system_tests/scenarios:central_sampler"],
    stack = "sampler_pod",
)

k3s_suite(
    name = "test_sampler_vm",
    scenarios = ["//agentplane/system_tests/scenarios:central_sampler"],
    stack = "sampler_vm",
)

k3s_suite(
    name = "test_vm_manual",
    scenarios = [
        "//agentplane/system_tests/scenarios:vm_workspace_ownership",
        "//agentplane/system_tests/scenarios:suspend_resume",
        "//agentplane/system_tests/scenarios:storage",
    ],
    stack = "vm",
    tags = ["manual"],
)

k3s_suite(
    name = "test_real_model",
    scenarios = [
        "//agentplane/system_tests/scenarios:egress",
        "//agentplane/system_tests/scenarios:session_instructions",
    ],
    stack = "real_model",
)
