load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

py_library(
    name = "actions",
    srcs = ["actions.py"],
    deps = [
        "//agentplane/action_service:models",
        "//agentplane:subjects",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "api",
    srcs = ["api.py"],
    deps = [
        "//agentplane/workload_auth:http",
        "//agentplane/workload_auth:principal",
        ":models",
        ":service",
        ":store",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "conftest",
    srcs = ["conftest.py"],
    testonly = True,
    deps = [
        "//agentplane/action_service:conftest",
        "//agentplane/action_service:database_migrate",
        "//agentplane/runner:conftest",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        ":database_migrate",
        ":store",
        "@pypi//asyncpg",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/notification_service/migrations:files"],
    deps = [
        "//util:db_migrations",
        ":db",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "instructions",
    srcs = ["instructions.py"],
    visibility = ["//agentplane/sandbox_service:__pkg__"],
    deps = [
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        "//agentplane/sandbox_service:client",
        "//agentplane/workload_auth:principal",
        ":actions",
        ":api",
        ":service",
        ":store",
        "@pypi//asyncpg",
        "@pypi//httpx",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//sqlalchemy",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        "//agentplane/protocol:command_pb2",
        "//agentplane/runner:errors",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:models",
        "//agentplane/sandbox_service:protocol_pb2",
        "//agentplane/workload_auth:principal",
        "//agentplane:subjects",
        ":actions",
        ":db",
        ":models",
        ":store",
        "@pypi//grpcio",
        "@pypi//httpx",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        "//agentplane/action_service:models",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/workload_auth:principal",
        "//agentplane:subjects",
        ":db",
        ":models",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_acceptance",
    srcs = ["test_acceptance.py"],
    size = "medium",
    deps = [
        "//:conftest",
        "//agentplane/action_service/test_fixtures:callers",
        "//agentplane/action_service:api",
        "//agentplane/action_service:auth",
        "//agentplane/action_service:catalog",
        "//agentplane/action_service:conftest",
        "//agentplane/action_service:db",
        "//agentplane/action_service:models",
        "//agentplane/action_service:service",
        "//agentplane/action_service:updates",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner/testing:scripted_model",
        "//agentplane/runner:conftest",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service/testing:kubernetes",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:protocol_pb2",
        "//agentplane/testing:fake_apiserver",
        "//agentplane/workload_auth:principal",
        "//agentplane:subjects",
        ":actions",
        ":api",
        ":conftest",
        ":db",
        ":instructions",
        ":service",
        ":store",
        "@pypi//httpx",
        "@pypi//kubernetes_asyncio",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    size = "medium",
    deps = [
        "//:conftest",
        "//agentplane/action_service:models",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/workload_auth:principal",
        "//agentplane:subjects",
        ":conftest",
        ":db",
        ":models",
        ":store",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_binary(name = "server", main_module = "agentplane.notification_service.main", deps = [":main"])
aspect_py_binary(name = "server_image_bin", main = "main.py", deps = [":main"])
py_image_layer(name = "server_layers", binary = ":server_image_bin", group = "1000", owner = "1000")
oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_image_bin"),
    env = py_image_env(binary_name = "server_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"], user = "1000:1000", visibility = ["//visibility:public"],
)

py_binary(name = "migrate", main_module = "agentplane.notification_service.database_migrate", deps = [":database_migrate"])
aspect_py_binary(name = "migration_image_bin", main = "database_migrate.py", deps = [":database_migrate"])
py_image_layer(name = "migration_layers", binary = ":migration_image_bin", group = "1000", owner = "1000")
oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":migration_layers"], user = "1000:1000", visibility = ["//visibility:public"],
)
