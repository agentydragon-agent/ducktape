# Lint tooling configuration

load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@npm_props_frontend//props/frontend:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm_props_frontend//props/frontend:prettier/package_json.bzl", prettier_bin = "bin")
load("@npm_props_frontend//props/frontend:svelte-check/package_json.bzl", svelte_check_bin = "bin")

package(default_visibility = ["//visibility:public"])

# ESLint binary for JS/TS linting
# Used by lint_eslint_aspect in linters.bzl
eslint_bin.eslint_binary(name = "eslint")

# Prettier binary for JS/TS/Svelte formatting
prettier_bin.prettier_binary(name = "prettier")

# Svelte-check binary for Svelte type checking
svelte_check_bin.svelte_check_binary(name = "svelte-check")

# Wrapper scripts for sh_test integration
exports_files([
    "run_prettier.sh",
    "run_svelte_check.sh",
])

# Buildifier targets for BUILD/Starlark linting
# Run: bazel run //:buildifier (fix mode)
# Run: bazel run //:buildifier.check (check mode)
buildifier(
    name = "buildifier",
    lint_mode = "fix",
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    lint_mode = "warn",
    mode = "diff",
)
