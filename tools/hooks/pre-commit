#!/bin/bash
# Git pre-commit hook using Aspect CLI for ruff linting.
#
# Install: ln -sf ../../tools/hooks/pre-commit .git/hooks/pre-commit
#
# Uses Bazel query to find targets containing staged files, then lints them.
# See bazelization/STATUS.md for full hook lifecycle documentation.

set -e

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
[ -z "$STAGED_PY" ] && exit 0

# Build regex pattern from staged files (escape dots, join with |)
PATTERN=$(echo "$STAGED_PY" | sed 's/\./\\./g' | tr '\n' '|' | sed 's/|$//')

# Find packages containing these files via Bazel query
PACKAGES=$(bazel query "attr('srcs', '.*($PATTERN).*', //...)" --output=package 2>/dev/null | \
    sed 's|^|//|; s|$|:all|' | sort -u | tr '\n' ' ')

[ -z "$PACKAGES" ] && exit 0

echo "Linting: $PACKAGES"
exec bazel lint $PACKAGES
