# Large binary files - download these with setup scripts
talos-amd64.iso
talosctl
_out/

# VM runtime files
*.qcow2
*.log
*.pid
vm.log

# Generated at runtime
kubeconfig-talos

# Sensitive configuration (contains certificates and keys)
talosconfig
controlplane.yaml
worker.yaml

# Terraform-generated sensitive files
terraform/kubeconfig
terraform/talosconfig
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
