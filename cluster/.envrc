# Inherit repo root environment (pre-commit, markdownlint-cli2, etc.)
source_up

# Use shell.nix for cluster-specific tools (kubeseal, talosctl, etc.)
use nix

# Hetzner Cloud + Proxmox API tokens (SOPS-encrypted, ../secrets/cluster-tokens.yaml)
export HCLOUD_TOKEN=$(sops -d --extract '["hcloud_token"]' ../secrets/cluster-tokens.yaml 2>/dev/null)
export TF_VAR_hcloud_token="$HCLOUD_TOKEN"
export PROXMOX_VE_API_TOKEN=$(sops -d --extract '["proxmox_ve_api_token"]' ../secrets/cluster-tokens.yaml 2>/dev/null)

# Set talos config and kubeconfig (generated by terraform)
export TALOSCONFIG="$PWD/terraform/main/talosconfig.yml"
export KUBECONFIG="$PWD/terraform/main/kubeconfig"
# kubeseal configured to use standard defaults (kube-system namespace)

# PG connection for OpenTofu state backend (CNPG tofu-state-db in k8s).
# Credentials from SOPS (no cluster access needed).
# From k8s workers: uses ClusterIP directly (no port-forward needed).
# From non-workers: use kubectl port-forward -n tofu-state svc/tofu-state-db-rw 15432:5432
_pg_user="tfstate"
_pg_name="tfstate"
_pg_pass=$(sops -d --extract '["password"]' ../secrets/tofu-state-db.yaml 2>/dev/null)
if [ -n "$_pg_pass" ]; then
  _cluster_ip=$(kubectl get svc -n tofu-state tofu-state-db-rw -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
  if [ -n "$_cluster_ip" ] && timeout 1 bash -c "echo >/dev/tcp/$_cluster_ip/5432" 2>/dev/null; then
    export PG_CONN_STR="postgres://${_pg_user}:${_pg_pass}@${_cluster_ip}:5432/${_pg_name}?sslmode=disable"
    echo "PG_CONN_STR configured (ClusterIP ${_cluster_ip})"
  else
    export PG_CONN_STR="postgres://${_pg_user}:${_pg_pass}@localhost:15432/${_pg_name}?sslmode=disable"
    echo "PG_CONN_STR configured (port-forward to localhost:15432 required)"
    echo "Run: kubectl port-forward -n tofu-state svc/tofu-state-db-rw 15432:5432"
  fi
else
  echo "WARNING: Could not decrypt tofu-state-db credentials from SOPS. PG_CONN_STR not set."
fi

cat <<'EOF'
🚀 Talos Kubernetes Cluster Environment
═══════════════════════════════════════
Authentik: https://auth.allegedly.works

get-passwords  - Retrieve Authentik passwords (akadmin & agentydragon@gmail.com)
EOF

# Add scripts directory to PATH
PATH_add scripts
