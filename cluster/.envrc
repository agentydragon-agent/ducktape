# Inherit repo root environment (pre-commit, markdownlint-cli2, etc.)
source_up

# Use shell.nix for cluster-specific tools (kubeseal, talosctl, etc.)
use nix

# Hetzner Cloud API token (stored in libsecret)
# Store with: echo -n "your-token" | secret-tool store --label='Hetzner Cloud API' service hcloud account default
# HCLOUD_TOKEN for CLI tools (hcloud)
# TF_VAR_hcloud_token for terraform provider
export HCLOUD_TOKEN=$(secret-tool lookup service hcloud account default 2>/dev/null)
export TF_VAR_hcloud_token="$HCLOUD_TOKEN"

# Proxmox root API token (stored in libsecret)
# Store with: secret-tool store --label="PVE root@pam tofu token" service proxmox account root-pam-tofu
# Used by terraform/main/ (bpg/proxmox provider for all Proxmox operations)
export PROXMOX_VE_API_TOKEN="root@pam!tofu=$(secret-tool lookup service proxmox account root-pam-tofu 2>/dev/null)"

# Set talos config and kubeconfig (generated by terraform)
export TALOSCONFIG="$PWD/terraform/main/talosconfig.yml"
export KUBECONFIG="$PWD/terraform/main/kubeconfig"
# kubeseal configured to use standard defaults (kube-system namespace)

# PG connection for OpenTofu state backend (CNPG tofu-state-db).
# Uses tfstate.allegedly.works (TLS passthrough via Gateway API TLSRoute).
# No port-forward needed — works from any machine with internet access.
_pg_ns="tofu-state"
_pg_secret="tofu-state-db-app"
_pg_user=$(kubectl get secret -n "$_pg_ns" "$_pg_secret" -o jsonpath='{.data.username}' 2>/dev/null | base64 -d)
_pg_pass=$(kubectl get secret -n "$_pg_ns" "$_pg_secret" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d)
_pg_name=$(kubectl get secret -n "$_pg_ns" "$_pg_secret" -o jsonpath='{.data.dbname}' 2>/dev/null | base64 -d)
if [ -n "$_pg_user" ]; then
  export PG_CONN_STR="postgres://${_pg_user}:${_pg_pass}@tfstate.allegedly.works:5432/${_pg_name}?sslmode=require"
  echo "PG_CONN_STR configured (tfstate.allegedly.works:5432)"
else
  echo "WARNING: Could not read tofu-state-db credentials from k8s. PG_CONN_STR not set."
fi

cat <<'EOF'
🚀 Talos Kubernetes Cluster Environment
═══════════════════════════════════════
Authentik: https://auth.allegedly.works

get-passwords  - Retrieve Authentik passwords (akadmin & agentydragon@gmail.com)
EOF

# Add scripts directory to PATH
PATH_add scripts
