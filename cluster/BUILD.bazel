# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([".tflint.hcl"])

py_library(
    name = "flux_convergence",
    srcs = ["flux_convergence.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":flux_convergence",
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)

py_test(
    name = "test_flux_convergence",
    srcs = ["test_flux_convergence.py"],
    deps = [
        ":flux_convergence",
        "@pypi//pytest_bazel",
    ],
)
