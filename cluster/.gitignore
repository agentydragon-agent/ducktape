.terraform/
*.tfstate
*.tfstate*.backup
*.tfstate.lock.info
terraform.tfvars
*.agekey

# SOPS age private key directories (generated by tofu, cached locally)
terraform/main/sops-cluster-secrets-keys/
talos/home/generated/

# Sensitive cluster credentials - generated by terraform
kubeconfig*
talosconfig*

# Nix cache signing key - generated by nix-store, cached locally
terraform/main/nix-cache-key.json

# Proxmox authentication vault password (stored in terraform state)
# credentials.vault itself is encrypted and safe to commit
terraform/pve-auth/terraform.tfvars

# Build artifacts and temporary files
*.log
tfplan
tmp/
.terraform.lock.hcl
