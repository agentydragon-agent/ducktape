{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This dashboard covers **host ext4/XFS filesystems** only. Its filesystem totals and attribution do not include Piraeus LVM thin pools, diskful PV limits, or copy estimates; see the **Piraeus LVM storage** dashboard for those separate accounting layers.\n\nFilesystem use is size minus free bytes, deduplicated by node and device. The attribution view separates measured components, unattributed bytes, root-reserved free space, and available bytes. Repeated mounts can refer to one underlying device.\n\nThe Storage tier selector filters by node labels; Machine filters node-owned panels. This is node-level filtering. If a node later has both SSD and HDD, per-device media labels will be needed to separate those disks."
      }
    },
    {
      "id": 2,
      "title": "Host filesystem used (ext4/XFS)",
      "description": "Sum of ext4/XFS filesystem size minus free bytes, deduplicated by node and device. This excludes ext4 root-reserved blocks and is host-filesystem accounting, separate from Piraeus thin-pool use.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "sum(disk_usage:filesystem_size_bytes{node=~\"$node\"} - on (node, device) disk_usage:filesystem_free_bytes{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Host filesystem capacity (ext4/XFS)",
      "description": "Total ext4/XFS host filesystem capacity from filesystem recording rules, deduplicated by node and device.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "sum(disk_usage:filesystem_size_bytes{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 23,
      "type": "row",
      "title": "Ext4/XFS host filesystem attribution",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 18,
      "title": "Ext4/XFS filesystem capacity by use",
      "description": "Host filesystem components, unattributed use, root-only reserve, and available bytes. Piraeus thin-pool physical use and volume-copy estimates are separate accounting layers.",
      "type": "piechart",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "sum by (category) (disk_usage:component_used_bytes{node=~\"$node\"})",
          "instant": true,
          "legendFormat": "{{category}}",
          "refId": "A"
        },
        {
          "expr": "sum(disk_usage:unattributed_bytes{node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Unattributed",
          "refId": "B"
        },
        {
          "expr": "sum(disk_usage:filesystem_free_bytes{node=~\"$node\"} - on (node, device) disk_usage:filesystem_avail_bytes{node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Reserved (root only)",
          "refId": "C"
        },
        {
          "expr": "sum(disk_usage:filesystem_avail_bytes{node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Free",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Free"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "rgba(115, 191, 105, 0.35)"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unattributed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reserved (root only)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 19,
      "title": "Host filesystem use by component",
      "description": "One bar per scraped ext4/XFS filesystem across the selected machines, labelled node, device, mountpoint, and media. Bars share the largest selected disk as their scale. Components come from existing filesystem rules; Piraeus pool physical use and per-copy estimates are separate.",
      "type": "barchart",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "label_join((sum by (node, device, component) (disk_usage:component_used_bytes{node=~\"$node\"}) or label_replace(disk_usage:unattributed_bytes{node=~\"$node\"}, \"component\", \"Unattributed\", \"\", \"\") or label_replace(disk_usage:filesystem_free_bytes{node=~\"$node\"} - disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Reserved (root only)\", \"\", \"\") or label_replace(disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Free\", \"\", \"\")) * on (node, device) group_left (mountpoint, media) (topk by (node, device) (1, disk_usage:mount:info{node=~\"$node\"}) * on (node, device) group_left (media) disk_usage:filesystem:info{node=~\"$node\"}), \"disk\", \" · \", \"node\", \"device\", \"mountpoint\", \"media\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max(disk_usage:filesystem_size_bytes{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "MaxDisk"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "MaxDisk",
            "mappings": [
              {
                "fieldName": "Value #MaxDisk",
                "handlerKey": "max"
              },
              {
                "fieldName": "Time",
                "handlerKey": "__ignore"
              }
            ],
            "applyTo": {
              "id": "byType",
              "options": "number"
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "component",
            "rowField": "disk",
            "valueField": "Value #A",
            "emptyValue": "null"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "disk\\component",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "disk\\component": "Disk"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisPlacement": "auto",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Free"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "rgba(115, 191, 105, 0.35)"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unattributed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reserved (root only)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Disk",
        "stacking": "normal",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelMaxLength": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      }
    },
    {
      "id": 20,
      "title": "Host filesystem attribution by node and device",
      "description": "Ext4/XFS filesystem component estimates, free bytes, and root-only reserve by node and device. Piraeus thin-pool accounting is kept separate; per-copy Piraeus allocation estimates do not form a residual against these filesystem bytes.",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "sort_desc((sum by (node, device, component) (disk_usage:component_used_bytes{node=~\"$node\"}) or label_replace(disk_usage:unattributed_bytes{node=~\"$node\"}, \"component\", \"Unattributed\", \"\", \"\") or label_replace(disk_usage:filesystem_free_bytes{node=~\"$node\"} - disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Reserved (root only)\", \"\", \"\") or label_replace(disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Free\", \"\", \"\")) * on (node, device) group_left (mountpoint, media) (topk by (node, device) (1, disk_usage:mount:info{node=~\"$node\"}) * on (node, device) group_left (media) disk_usage:filesystem:info{node=~\"$node\"}))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "(sum by (node, device, component) (disk_usage:component_used_bytes{node=~\"$node\"}) or label_replace(disk_usage:unattributed_bytes{node=~\"$node\"}, \"component\", \"Unattributed\", \"\", \"\") or label_replace(disk_usage:filesystem_free_bytes{node=~\"$node\"} - disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Reserved (root only)\", \"\", \"\") or label_replace(disk_usage:filesystem_avail_bytes{node=~\"$node\"}, \"component\", \"Free\", \"\", \"\")) * on (node, device) group_left (mountpoint, media) (topk by (node, device) (1, disk_usage:mount:info{node=~\"$node\"}) * on (node, device) group_left (media) disk_usage:filesystem:info{node=~\"$node\"}) / on (node, device) group_left () disk_usage:filesystem_size_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "node": 0,
              "device": 1,
              "mountpoint": 2,
              "media": 3,
              "component": 4,
              "Value #A": 5,
              "Value #B": 6
            },
            "renameByName": {
              "node": "Machine",
              "device": "Device",
              "mountpoint": "Mountpoint",
              "media": "Media",
              "component": "Component",
              "Value #A": "Bytes",
              "Value #B": "Share of disk"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Bytes",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Share of disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      }
    },
    {
      "id": 21,
      "title": "Unattributed bytes per disk",
      "description": "Filesystem used (size minus free) minus every attributed component. On system disks (/var, /) this is mostly container images, emptyDir volumes, logs and etcd, which no scraped metric breaks down; on data disks, see the PVC list beside it.",
      "type": "bargauge",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "sort_desc(label_join(disk_usage:unattributed_bytes{node=~\"$node\"} * on (node, device) group_left (mountpoint, media) (topk by (node, device) (1, disk_usage:mount:info{node=~\"$node\"}) * on (node, device) group_left (media) disk_usage:filesystem:info{node=~\"$node\"}), \"disk\", \" · \", \"node\", \"device\", \"mountpoint\", \"media\"))",
          "instant": true,
          "legendFormat": "{{disk}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Current host filesystem use by mount",
      "description": "Per-mount ext4/XFS data used from deduplicated per-device filesystem recordings. Repeated mounts, including bind mounts, are shown as detail rows; dashboard totals count each device once.",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": "${DS_MIMIR}",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sort_desc((disk_usage:filesystem_size_bytes{node=~\"$node\"} - on (node, device) disk_usage:filesystem_free_bytes{node=~\"$node\"}) * on (node, device) group_right disk_usage:mount:info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}} {{device}} {{mountpoint}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Largest host filesystem mounts over time",
      "description": "Top ten ext4/XFS mounts by data used, joined from deduplicated per-device filesystem recordings. Repeated mounts can show the same underlying device; they are detail series, not additive capacity.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": "${DS_MIMIR}",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, (disk_usage:filesystem_size_bytes{node=~\"$node\"} - on (node, device) disk_usage:filesystem_free_bytes{node=~\"$node\"}) * on (node, device) group_right disk_usage:mount:info{node=~\"$node\"})",
          "legendFormat": "{{node}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["cluster", "disk", "storage", "filesystem", "ext4", "xfs"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Both",
          "value": "ssd|hdd"
        },
        "includeAll": false,
        "label": "Storage tier",
        "name": "storage_tier",
        "options": [
          {
            "selected": false,
            "text": "SSD",
            "value": "ssd"
          },
          {
            "selected": false,
            "text": "HDD",
            "value": "hdd"
          },
          {
            "selected": true,
            "text": "Both",
            "value": "ssd|hdd"
          }
        ],
        "query": "SSD : ssd,HDD : hdd,Both : ssd|hdd",
        "type": "custom"
      },
      {
        "current": {
          "text": "All",
          "value": ["$__all"]
        },
        "datasource": "${DS_MIMIR}",
        "definition": "label_values(kube_node_labels{label_storage_allegedly_works_tier=~\"$storage_tier\"}, node)",
        "includeAll": true,
        "label": "Machine",
        "multi": true,
        "name": "node",
        "query": "label_values(kube_node_labels{label_storage_allegedly_works_tier=~\"$storage_tier\"}, node)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Host filesystem usage · ext4/XFS",
  "uid": "cluster-disk-usage",
  "version": 1,
  "weekStart": ""
}
