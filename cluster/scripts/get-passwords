#!/usr/bin/env bash
set -euo pipefail

# Retrieve Authentik passwords from Kubernetes secrets
# Usage: get-passwords

echo "=== Authentik Passwords ==="
echo ""

# Get admin bootstrap password
ADMIN_PASSWORD=$(kubectl get secret -n authentik authentik-admin-password \
	-o jsonpath='{.data.AUTHENTIK_BOOTSTRAP_PASSWORD}' 2>/dev/null | base64 -d)

if [ -n "$ADMIN_PASSWORD" ] && [ "$ADMIN_PASSWORD" != "null" ]; then
	echo "Admin (akadmin):           $ADMIN_PASSWORD"
else
	echo "Admin (akadmin):           [ERROR: Could not retrieve]" >&2
fi

# Get agentydragon user password
USER_PASSWORD=$(kubectl get secret -n agentydragon agentydragon-user-password \
	-o jsonpath='{.data.user_password}' 2>/dev/null | base64 -d)

if [ -n "$USER_PASSWORD" ] && [ "$USER_PASSWORD" != "null" ]; then
	echo "User (agentydragon@gmail.com): $USER_PASSWORD"
else
	echo "User (agentydragon@gmail.com): [ERROR: Could not retrieve]" >&2
fi

echo ""
echo "=== Props (props.allegedly.works) ==="
echo ""

PROPS_ADMIN_PASSWORD=$(kubectl get secret -n props props-postgresql \
	-o jsonpath='{.data.postgres-password}' 2>/dev/null | base64 -d)

if [ -n "$PROPS_ADMIN_PASSWORD" ] && [ "$PROPS_ADMIN_PASSWORD" != "null" ]; then
	echo "Admin (postgres):          $PROPS_ADMIN_PASSWORD"
else
	echo "Admin (postgres):          [Not found]"
fi

PROPS_EVAL_PASSWORD=$(kubectl get secret -n props props-evaluator-credentials \
	-o jsonpath='{.data.password}' 2>/dev/null | base64 -d)

if [ -n "$PROPS_EVAL_PASSWORD" ] && [ "$PROPS_EVAL_PASSWORD" != "null" ]; then
	echo "Evaluator (evaluator):     $PROPS_EVAL_PASSWORD"
else
	echo "Evaluator (evaluator):     [Not found]"
fi

echo ""
echo "=== OpenClaw Gateway Token ==="
echo ""

# Get OpenClaw gateway token (one-time entry in UI settings)
OPENCLAW_TOKEN=$(kubectl get secret -n openclaw openclaw-gateway-token \
	-o jsonpath='{.data.token}' 2>/dev/null | base64 -d)

if [ -n "$OPENCLAW_TOKEN" ] && [ "$OPENCLAW_TOKEN" != "null" ]; then
	echo "Gateway token: $OPENCLAW_TOKEN"
	echo "(Enter once in OpenClaw UI connection settings)"
else
	echo "Gateway token: [Not found — operator may not have generated it yet]"
fi

echo ""
