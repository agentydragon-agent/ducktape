# gazelle:ignore
# Cluster validation libraries — used by //devinfra/precommit and
# //cluster/validation:test_cluster_integration.

load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = [
    "//cluster:__subpackages__",
    "//devinfra/precommit:__pkg__",
])

py_library(
    name = "tool_resolve",
    srcs = ["tool_resolve.py"],
    deps = ["//util/bazel:runfiles"],
)

py_library(
    name = "kustomize",
    srcs = ["kustomize.py"],
    data = ["@multitool//tools/kustomize"],
    deps = [
        ":tool_resolve",
        "//cluster/validation:k8s",
        "//cluster/validation:kustomize",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "flux",
    srcs = ["flux.py"],
    data = ["@multitool//tools/flux"],
    deps = [
        ":tool_resolve",
        "//cluster/validation:k8s",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "checks",
    srcs = ["checks.py"],
    deps = [
        "//cluster/validation:cluster",
        "//cluster/validation:kustomize",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "helm_templates",
    srcs = ["helm_templates.py"],
    data = [
        "//cluster/terraform/main:cilium-values.yaml",
        "@multitool//tools/helm",
    ],
    deps = [
        ":tool_resolve",
        "//util/bazel:runfiles",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":checks",
        ":flux",
        ":helm_templates",
        ":kustomize",
        "//cluster/validation:cluster",
        "//cluster/validation:crd_layering",
        "//cluster/validation:dependencies",
        "//cluster/validation:health_checks",
        "//cluster/validation:kustomize",
    ],
)
