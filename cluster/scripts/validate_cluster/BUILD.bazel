# gazelle:ignore
# Cluster validation scripts
#
# Binaries:
#   validate_sealed_secrets — sealed secret decryption (separate, needs terraform state)
#   kustomize_build_all — serialize kustomize build output to JSON
#
# Live tests (test_live_*):
#   Individual cluster validation checks as Bazel test targets.
#   Pure-analysis checks use //cluster/k8s:all_yaml as data deps.
#   Kustomize-dependent checks consume a genrule that builds all kustomizations.
#
# Binaries (kustomize, flux, kubeseal, helm, tofu) are managed via rules_multitool.
#
# Usage:
#   bazel test //cluster/scripts/validate_cluster:test_live_orphaned_files
#   bazel test //cluster/scripts/validate_cluster/...

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

package(default_visibility = [
    "//cluster:__subpackages__",
    "//devinfra/precommit:__pkg__",
])

# ============================================================================
# Kustomization validation — domain modules
# ============================================================================

py_library(
    name = "k8s",
    srcs = ["k8s.py"],
    imports = ["../../.."],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "kustomize",
    srcs = ["kustomize.py"],
    imports = ["../../.."],
    deps = [
        ":k8s",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "flux",
    srcs = ["flux.py"],
    imports = ["../../.."],
    deps = [
        ":k8s",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "cluster",
    srcs = ["cluster.py"],
    imports = ["../../.."],
    deps = [
        ":flux",
        ":k8s",
        ":kustomize",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "checks",
    srcs = ["checks.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        ":flux",
        ":k8s",
        ":kustomize",
    ],
)

py_library(
    name = "dependencies",
    srcs = ["dependencies.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        ":flux",
    ],
)

# ============================================================================
# Sealed secrets validation (separate binary — different deps/trigger pattern)
# ============================================================================

py_library(
    name = "sealed_secrets",
    srcs = ["sealed_secrets.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
    ],
)

py_binary(
    name = "validate_sealed_secrets",
    data = [
        "@multitool//tools/kubeseal",
        "@multitool//tools/tofu",
    ],
    imports = ["../../.."],
    main_module = "cluster.scripts.validate_cluster.sealed_secrets",
    deps = [":sealed_secrets"],
)

py_library(
    name = "helm_templates",
    srcs = ["helm_templates.py"],
    imports = ["../../.."],
    deps = ["//util/bazel:runfiles"],
)

# ============================================================================
# Kustomize build serialization (for external consumers / CI scripts)
# ============================================================================

py_library(
    name = "kustomize_build_all_lib",
    srcs = ["kustomize_build_all.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        ":kustomize",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "kustomize_build_all",
    data = ["@multitool//tools/kustomize"],
    imports = ["../../.."],
    main_module = "cluster.scripts.validate_cluster.kustomize_build_all",
    deps = [":kustomize_build_all_lib"],
)

# ============================================================================
# Kustomize build genrule — builds all kustomizations, outputs JSON
# ============================================================================

genrule(
    name = "kustomize_build_results",
    srcs = ["//cluster/k8s:all_yaml"],
    outs = ["kustomize_build_results.json"],
    cmd = "$(location :kustomize_build_all) cluster/k8s $@",
    tools = [":kustomize_build_all"],
)

