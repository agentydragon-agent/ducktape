# gazelle:ignore
# Cluster utility scripts (non-validation).
# Validators are in //cluster/scripts/validate_cluster/.

load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "generate_claude_kubeconfig_lib",
    srcs = ["generate_claude_kubeconfig.py"],
    visibility = ["//cluster:__pkg__"],
    deps = [
        "//devinfra/claude:hook_config",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
    ],
)

py_binary(
    name = "generate_claude_kubeconfig",
    main_module = "cluster.scripts.generate_claude_kubeconfig",
    deps = [":generate_claude_kubeconfig_lib"],
)

# Verify Authentik authentication works end-to-end
py_binary(
    name = "check_authentik_login",
    srcs = ["check_authentik_login.py"],
)
