load("@io_bazel_rules_go//go:def.bzl", "go_library")

# Wraps the upstream controllers/kubespan package for kubespand.
# Embeds the overlay target so all upstream symbols are available.

go_library(
    name = "peerspec",
    embed = ["@talos_internal//:controllers_kubespan"],
    importpath = "github.com/siderolabs/talos/internal/app/machined/pkg/controllers/kubespan",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
