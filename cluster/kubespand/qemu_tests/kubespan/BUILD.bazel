load("@io_bazel_rules_go//go:def.bzl", "go_test")

_QEMU_TAGS = [
    "cpu:4",
    "requires_qemu",
]

# Compute units per worker type. Talos VMs are heavier under TCG emulation
# (full OS boot vs lightweight Alpine initramfs).
_EXEC_PROPERTIES = {
    "kubespand": {"EstimatedComputeUnits": "6"},
    "talos": {"EstimatedComputeUnits": "8"},
}

# ─ Topology tests: split by variant for RBE parallelism ─────────────────────
# Each variant runs on a separate RBE worker, avoiding 12-16 VMs competing for
# CPU on a single machine under TCG emulation.

_TOPOLOGY_DATA = [
    "//cluster/kubespand/qemu_tests:vmlinuz",
    "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
    "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
    "//cluster/kubespand/qemu_tests/vms/kubespan:initramfs",
]

_TOPOLOGY_DEPS = [
    "//cluster/kubespand/qemu_tests",
    "@com_github_siderolabs_talos_pkg_machinery//config/types/v1alpha1",
]

[go_test(
    name = "topology_{topology}_{worker_type}_test".format(
        topology = topology,
        worker_type = worker_type,
    ),
    timeout = "long",
    srcs = [
        "flat_test.go",
        "topology_test_helper.go",
    ],
    args = ["-test.run=TestTopology/{topology}/{worker_type}$$".format(
        topology = topology,
        worker_type = worker_type,
    )],
    data = _TOPOLOGY_DATA,
    exec_properties = _EXEC_PROPERTIES[worker_type],
    tags = _QEMU_TAGS,
    deps = _TOPOLOGY_DEPS,
) for topology in [
    "flat",
    "cross_subnet",
] for worker_type in [
    "kubespand",
    "talos",
]]

# ─ Trustd CSR flow tests: split by worker type ──────────────────────────────

_TRUSTD_DATA = [
    "//cluster/kubespand/qemu_tests:vmlinuz",
    "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
    "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
    "//cluster/kubespand/qemu_tests/vms/trustd:initramfs",
]

[go_test(
    name = "trustd_{worker_type}_test".format(worker_type = worker_type),
    timeout = "long",
    srcs = ["trustd_test.go"],
    args = ["-test.run=TestTrustdCSRFlow/{worker_type}$$".format(worker_type = worker_type)],
    data = _TRUSTD_DATA,
    exec_properties = _EXEC_PROPERTIES[worker_type],
    tags = _QEMU_TAGS,
    deps = ["//cluster/kubespand/qemu_tests"],
) for worker_type in [
    "kubespand",
    "talos",
]]
