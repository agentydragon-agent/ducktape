load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//cluster/kubespand:upstream.bzl", "TALOS_ADAPTERS_KUBESPAN", "talos_copy")

talos_copy(
    name = "peer_status",
    src = TALOS_ADAPTERS_KUBESPAN + "peer_status.go",
    out = "peer_status.go",
)

talos_copy(
    name = "identity",
    src = TALOS_ADAPTERS_KUBESPAN + "identity.go",
    out = "identity.go",
)

go_library(
    name = "kubespan",
    srcs = [
        ":identity",
        ":peer_status",
    ],
    importpath = "github.com/siderolabs/talos/internal/app/machined/pkg/adapters/kubespan",
    visibility = ["//cluster/kubespand:__subpackages__"],
    deps = [
        "@com_github_mdlayher_netx//eui64",
        "@com_github_siderolabs_gen//value",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@com_zx2c4_golang_wireguard_wgctrl//wgtypes",
        "@org_go4_netipx//:netipx",
    ],
)
