load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//cluster/kubespand:upstream.bzl", "TALOS_CONTROLLERS_NETWORK", "talos_copy")

talos_copy(
    name = "nftables_chain",
    src = TALOS_CONTROLLERS_NETWORK + "nftables_chain.go",
    out = "nftables_chain.go",
)

go_library(
    name = "network",
    srcs = [
        ":nftables_chain",
    ],
    importpath = "github.com/siderolabs/talos/internal/app/machined/pkg/controllers/network",
    visibility = ["//cluster/kubespand:__subpackages__"],
    deps = [
        "//cluster/kubespand/talos/adapters/network",
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@org_uber_go_zap//:zap",
    ],
)
