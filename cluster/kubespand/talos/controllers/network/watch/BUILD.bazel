load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//cluster/kubespand:upstream.bzl", "TALOS_CONTROLLERS_NETWORK_WATCH", "talos_copy")

talos_copy(
    name = "watch_iface",
    src = TALOS_CONTROLLERS_NETWORK_WATCH + "watch.go",
    out = "watch.go",
)

talos_copy(
    name = "rtnetlink",
    src = TALOS_CONTROLLERS_NETWORK_WATCH + "rtnetlink.go",
    out = "rtnetlink.go",
)

talos_copy(
    name = "trigger",
    src = TALOS_CONTROLLERS_NETWORK_WATCH + "trigger.go",
    out = "trigger.go",
)

go_library(
    name = "watch",
    srcs = [
        ":rtnetlink",
        ":trigger",
        ":watch_iface",
    ],
    importpath = "github.com/siderolabs/talos/internal/app/machined/pkg/controllers/network/watch",
    visibility = ["//cluster/kubespand:__subpackages__"],
    deps = [
        "@com_github_jsimonetti_rtnetlink_v2//:rtnetlink",
        "@com_github_mdlayher_netlink//:netlink",
        "@org_golang_x_time//rate",
    ],
)
