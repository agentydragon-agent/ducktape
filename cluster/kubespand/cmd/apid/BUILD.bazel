load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "apid_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/cmd/apid",
    deps = ["@com_github_siderolabs_talos//internal/app/apid"],
)

go_binary(
    name = "apid",
    embed = [":apid_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
