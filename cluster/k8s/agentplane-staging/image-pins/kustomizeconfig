# Kustomize transformer configuration, not a Kubernetes manifest: teaches `images:` where to find
# image fields in our SandboxTemplate, which the transformer does not reach by default.
images:
  - path: spec/pod/spec/containers[]/image
    kind: SandboxTemplate
  - path: spec/vm/template/spec/volumes[]/containerDisk/image
    kind: SandboxTemplate
  - path: spec/pod/spec/volumes[]/image/reference
    kind: SandboxTemplate
