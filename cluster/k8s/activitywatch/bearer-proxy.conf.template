# Bearer-checking proxy for ActivityWatch's two token-gated routes. The central
# aw-server has no auth of its own, so this one nginx is the gate for both, as
# separate server blocks on separate ports:
#   - 5602 write route (activitywatch-write.allegedly.works): the shared write
#     token; the synced desktops send the same value as AW_DEST_TOKEN. All methods,
#     because the importer reads the dest to dedup (see CLEANUP below).
#   - 5603 read route (activitywatch-read.allegedly.works): a distinct read token,
#     read methods only (GET plus POST for /api/0/query), so even a leaked read
#     token cannot write. The Haku agent calls it with the read token.
# Distinct ports keep the routes' hostnames, Services, and tokens separate; only the
# nginx process is shared. The unauthenticated readonly path (5601, readonly-proxy.conf)
# stays its own sidecar -- Authentik is its auth boundary.
#
# nginx:alpine runs envsubst on templates; NGINX_ENVSUBST_FILTER pins it to ^AW_ so
# ${AW_WRITE_TOKEN}/${AW_READ_TOKEN} are filled from the secrets while nginx's own
# $-variables ($http_authorization, $host, ...) are left intact.
#
# CLEANUP: the importer reads the dest for dedup, so the write route must allow GET
#   as well as POST -- a leaked write token can therefore read history, not just
#   ingest. Restrict it to write methods once the importer syncs incrementally from a
#   local high-water mark and no longer reads the destination (see
#   cluster/docs/activitywatch/revival-plan.md).

# The map key "Bearer <64-hex token>" is 71 bytes, past nginx's default 64-byte
# bucket -- without this bump nginx dies at startup with "could not build map_hash".
map_hash_bucket_size 128;

map $http_authorization $aw_write_ok {
    default 0;
    "Bearer ${AW_WRITE_TOKEN}" 1;
}

map $http_authorization $aw_read_ok {
    default 0;
    "Bearer ${AW_READ_TOKEN}" 1;
}

# Write route: bearer-gated, all methods (importer reads dest to dedup).
server {
    listen 5602;

    # The importer POSTs a whole bucket's events in one request, so a busy
    # history bucket far exceeds nginx's 1m default. Cap generously (nginx spills
    # bodies past client_body_buffer_size to a disk temp, not the 64Mi RAM limit);
    # the incremental-sync follow-up will shrink these bodies to per-run deltas.
    client_max_body_size 256m;

    location = /healthz {
        return 200 "ok";
    }

    location / {
        if ($aw_write_ok = 0) {
            return 401;
        }
        proxy_pass http://127.0.0.1:5600;
        proxy_set_header Host $host;
        # aw-server-rust CORS allow-lists localhost; drop Origin like the read proxy.
        proxy_set_header Origin "";
    }
}

# Read route: bearer-gated, read methods only -- GET anything, plus POST for
# /api/0/query's large query bodies, so even the read token cannot write.
server {
    listen 5603;

    location = /healthz {
        return 200 "ok";
    }

    location / {
        if ($aw_read_ok = 0) {
            return 401;
        }
        limit_except GET {
            deny all;
        }
        proxy_pass http://127.0.0.1:5600;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
    }

    # The query endpoint, with or without its trailing slash, so the slash stops being
    # load-bearing. A prefix location ending in `/` implicit-301s the short spelling to nginx's
    # own cleartext listen port -- Location: http://<host>:5603/api/0/query/ -- which no client
    # can follow: TLS terminates at the Gateway, and the Gateway does not serve 5603. One regex
    # location answers both spellings; `rewrite ... break` normalizes the path for aw-server
    # internally, so the method, body and query args survive and the upstream sees exactly the
    # path it sees today (a no-op for the slash form).
    #
    # Regex, not prefix: a prefix `/api/0/query` would also match `/api/0/queryanything` and
    # rewrite that into a valid request, so the pattern stays anchored with `/?$`. nginx strips
    # the query string before matching, so `?duration=...` cannot defeat the anchor. Anything
    # deeper (`/api/0/query/<x>`) falls through to `location /` as it does today -- aw-server has
    # no subroute there.
    #
    # Rocket normalizes a trailing slash on this server -- /api/0/buckets, /api/0/settings,
    # /api/0/info and <bucket>/events each answer 200 either way -- but that is unmeasured for
    # the query route, and this route does not depend on it.
    location ~ ^/api/0/query/?$ {
        if ($aw_read_ok = 0) {
            return 401;
        }
        limit_except GET POST {
            deny all;
        }
        rewrite ^ /api/0/query/ break;
        proxy_pass http://127.0.0.1:5600;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
    }
}
