# Talos nocloud disk image with Nebula system extension.
# Downloaded pre-built from Talos Image Factory, converted to qcow2.
# The imager profile's systemExtensions field is only supported by the
# Image Factory API, not the bare imager container.

genrule(
    name = "talos_nebula_image",
    outs = ["nocloud-amd64.raw.zst"],
    cmd = """
        set -e
        SCHEMATIC="011ccccdcfa98314d2550cb33b56426be8f45553fce129a1e6124de63e9f1598"
        VERSION="v1.13.0-alpha.2"
        URL="https://factory.talos.dev/image/$${SCHEMATIC}/$${VERSION}/nocloud-amd64.raw.zst"
        curl -sSfL "$$URL" -o $@
    """,
    visibility = ["//cluster/nebula_demo:__subpackages__"],
)
