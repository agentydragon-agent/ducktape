load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("@npm_ducktape//:vite/package_json.bzl", vite_bin = "bin")
load("@npm_ducktape//:svelte-check/package_json.bzl", svelte_check_bin = "bin")
load("@npm_ducktape//:@sveltejs/kit/package_json.bzl", svelte_kit_bin = "bin")
load("@npm_ducktape//:storybook/package_json.bzl", storybook_bin = "bin")
load("@npm_ducktape//:@playwright/test/package_json.bzl", playwright_bin = "bin")
load("@aspect_rules_js//js:defs.bzl", "js_run_devserver")

# Link npm packages from root package.json
npm_link_all_packages(name = "node_modules")

# Export config files
exports_files([
    ".prettierrc",
    "tsconfig.json",
])

# Source files for the frontend
_SRCS = glob([
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.css",
    "src/**/*.html",
    "static/**",
    ".storybook/**/*.ts",
]) + [
    "svelte.config.js",
    "vite.config.ts",
    "tsconfig.json",
    "playwright.config.ts",
]

# ESLint check - now handled by workspace-level aspect
# Run: bazel build --config=eslint //props/frontend:all
# Or: bazel build --config=lint //...  (runs both ruff and eslint)
# The aspect uses //:eslintrc (root eslint.config.js) with file patterns

