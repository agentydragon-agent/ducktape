# Generate .svelte-kit directory (required by svelte-check for tsconfig)
# Run: bazel build //props/frontend:svelte_kit_sync
# Note: srcs must include src files so svelte-kit detects $lib, routes, etc.
svelte_kit_bin.svelte_kit(
    name = "svelte_kit_sync",
    srcs = [
        ":node_modules",
        "svelte.config.js",
        "vite.config.ts",
        "tsconfig.json",
    ] + glob([
        "src/**/*.ts",
        "src/**/*.svelte",
    ]),
    args = ["sync"],
    chdir = package_name(),
    out_dirs = [".svelte-kit"],
)

# Svelte-check (type checking)
# Run: bazel test //props/frontend:svelte_check_test
svelte_check_bin.svelte_check_test(
    name = "svelte_check_test",
    args = [
        "--tsconfig",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":svelte_kit_sync",  # Depends on .svelte-kit directory
        "tsconfig.json",
        "svelte.config.js",
        "vite.config.ts",
    ] + glob(["src/**/*.ts", "src/**/*.svelte"]),
    tags = ["lint"],
)

# Vite build (production bundle)
# Run: bazel build //props/frontend:bundle
# Output: bazel-bin/props/frontend/dist/
vite_bin.vite(
    name = "bundle",
    srcs = _SRCS + [":node_modules"],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

# Vite dev server
# Run: bazel run //props/frontend:dev
js_run_devserver(
    name = "dev",
    args = ["dev"],
    chdir = package_name(),
    data = _SRCS + [":node_modules"],
    tool = "//tools/frontend:vite",
)

# Storybook source files (stories + config)
# Note: _SRCS already includes src/**/*.ts (which includes *.stories.ts)
# Note: _SRCS already includes .storybook/**/*.ts
_STORYBOOK_SRCS = _SRCS + glob([
    "src/**/*.mdx",
])

# Storybook static build
# Run: bazel build //props/frontend:storybook
# Output: bazel-bin/props/frontend/storybook-static/
# Note: Depends on svelte_kit_sync for .svelte-kit/tsconfig.json that tsconfig.json extends
# svelte.config.js detects storybook via process.argv and uses .svelte-kit-storybook for its own output
storybook_bin.storybook(
    name = "storybook",
    srcs = _STORYBOOK_SRCS + [":node_modules", ":svelte_kit_sync"],
    args = ["build"],
    chdir = package_name(),
    out_dirs = [".svelte-kit-storybook", "storybook-static"],
)

# Storybook dev server
# Run: bazel run //props/frontend:storybook_dev
js_run_devserver(
    name = "storybook_dev",
    args = ["dev", "-p", "6006"],
    chdir = package_name(),
    data = _STORYBOOK_SRCS + [":node_modules", ":svelte_kit_sync"],
    tags = ["manual"],  # Dev servers are run, not built
    tool = "//tools/frontend:storybook",
)

# Visual regression tests (Playwright + Storybook)
# Run: bazel test //props/frontend:visual_test
# Browser binaries from rules_playwright (no npx install needed).
#
# ISSUE: playwright_bin.playwright_test causes module resolution conflicts.
# The runner and test file resolve @playwright/test to different module instances
# due to aspect_rules_js's node_modules structure. For now, this is marked manual
# and can be run via pnpm: cd props/frontend && pnpm playwright test
#
# TODO: Fix proper Bazel integration - options:
# 1. Use js_test with explicit module resolution control
# 2. Investigate patch_node_fs behavior with playwright's transform
# 3. Consider rules_playwright test rule if one exists
playwright_bin.playwright_test(
    name = "visual_test",
    args = [
        "test",
        "--config",
        "props/frontend/playwright.config.ts",
    ],
    data = [
        ":node_modules",
        "//:node_modules/@playwright/test",
        ":storybook",
        "playwright.config.ts",
        "@playwright//:chromium-headless-shell",
    ] + glob(["tests/**/*"]),
    env = {
        "PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @playwright//:chromium-headless-shell)/../",
        "NODE_PATH": "node_modules",
    },
    tags = ["manual", "no-sandbox", "visual"],
    timeout = "long",
)
