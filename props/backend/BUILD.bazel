"""Props backend - FastAPI dashboard server."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "backend",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            ".*/**",
            "tests/**",
        ],
    ),
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_infra",
        "//props/core",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "backend_cli",
    srcs = ["cli.py"],
    main = "cli.py",
    visibility = ["//props/frontend:__pkg__"],
    deps = [":backend"],
)

py_binary(
    name = "export_schema",
    srcs = ["export_schema.py"],
    main = "export_schema.py",
    deps = [":backend"],
)

genrule(
    name = "openapi_schema",
    outs = ["openapi.json"],
    cmd = "$(location :export_schema) > $@",
    tools = [":export_schema"],
    visibility = ["//props/frontend:__pkg__"],
)

py_test(
    name = "test_backend",
    srcs = glob(["tests/**/*.py"]),
    main = "tests/test_placeholder.py",
    deps = [
        ":backend",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":backend"],
)
