"""Dead Code agent OCI image built with Bazel.

Build targets:
    bazel run //props/core/agent_defs/dead_code:load  -- Load into local Docker
    bazel run //props/core/agent_defs/dead_code:push  -- Push to local registry (localhost:5050)
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Package props CLI and dependencies for runtime
pkg_tar(
    name = "app_tar",
    srcs = ["//props/core:props"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

pkg_tar(
    name = "agent_md_tar",
    srcs = ["agent.md"],
    package_dir = "/",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    entrypoint = ["/init"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [
        ":app_tar",
        "//props/core/agent_defs:critic_dev_init_tar",
        ":agent_md_tar",
    ],
    workdir = "/workspace",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["critic-agent:dead-code"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["dead-code"],
    repository = "localhost:5050/critic",
)
