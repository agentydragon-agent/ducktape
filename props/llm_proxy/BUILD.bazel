"""LLM proxy OCI image built with Bazel.

The proxy validates agent tokens, enforces model restrictions,
and logs all requests to the llm_requests table.

Build targets:
    bazel run //props/llm_proxy:load  -- Load into local Docker
    bazel run //props/llm_proxy:push  -- Push to local registry (localhost:5050)
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "proxy_lib",
    srcs = ["proxy.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//props/core/db:models",
        "//props/core/db:session",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//psycopg",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_binary(
    name = "llm_proxy",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        ":proxy_lib",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

pkg_tar(
    name = "app_tar",
    srcs = [":llm_proxy"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    cmd = ["/app/llm_proxy"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "OPENAI_UPSTREAM_URL": "https://api.openai.com",
        "PORT": "5052",
        "LOG_LEVEL": "info",
    },
    exposed_ports = ["5052/tcp"],
    tars = [":app_tar"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["props-llm-proxy:latest"],
)

# Push to local registry (localhost:5050, running via devenv)
# Usage: bazel run //props/llm_proxy:push
oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:5050/llm-proxy",
)
