# Inherit workspace venv from parent
source_up

# Load devenv's direnv integration (provides caching + helpers)
eval "$(devenv direnvrc)"

# Trigger rebuilds when local devenv changes
watch_file devenv.nix

# Activate the props-specific devenv (postgres, env vars)
use devenv

# Specimens data directory (at repo root, outside package)
REPO_ROOT=$(git rev-parse --show-toplevel)
export ADGN_PROPS_SPECIMENS_ROOT="$REPO_ROOT/../specimens"

# Check if PostgreSQL is ready
_check_postgres_ready() {
  if docker ps --format '{{.Names}}' | grep -q '^props-postgres$'; then
    if docker inspect props-postgres --format "{{.State.Running}}" 2>/dev/null | grep -q true; then
      echo "Props ready. Database: props-postgres (running)"
      echo "  Recreate/reseed DB: props db-recreate --yes"
      return 0
    fi
  fi
  echo "Props setup ready. Start PostgreSQL with: devenv up"
  return 0
}

_check_postgres_ready
