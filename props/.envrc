# Inherit workspace venv from parent
source_up

# Load devenv's direnv integration (provides caching + helpers)
eval "$(devenv direnvrc)"

# Trigger rebuilds when local devenv changes
watch_file devenv.nix

# Activate the props-specific devenv (postgres, env vars)
use devenv

# Specimens data directory (at repo root, outside package)
REPO_ROOT=$(git rev-parse --show-toplevel)
export ADGN_PROPS_SPECIMENS_ROOT="$REPO_ROOT/../specimens"

# Check if PostgreSQL is ready and print banner
_props_banner() {
  echo "Props development environment"
  echo ""
  if docker ps --format '{{.Names}}' | grep -q '^props-postgres$'; then
    if docker inspect props-postgres --format "{{.State.Running}}" 2>/dev/null | grep -q true; then
      echo "Database:  props-postgres (running)"
    else
      echo "Database:  props-postgres (not running) - start with: devenv up"
    fi
  else
    echo "Database:  not started - run: devenv up"
  fi
  echo "CLI:       bazelisk run //props/core:props -- --help"
  echo "Backup:    bazelisk run //props/core:props -- db backup | restore FILE | list-backups"
  echo "Dev:       bazelisk run //props/frontend:dev  (frontend + backend)"
  echo "Build:     bazelisk build //props/frontend:bundle"
}

_props_banner
