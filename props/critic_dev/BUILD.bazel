"""Critic development CLI and shared types.

Shared infrastructure for prompt optimizer and improvement agents.
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# =============================================================================
# Shared types
# =============================================================================

py_library(
    name = "shared",
    srcs = ["shared.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "prompt_eval_server",
    srcs = ["prompt_eval_server.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":shared",
        "//mcp_infra",
        "//mcp_infra/enhanced",
        "//openai_utils",
        "//props/core:exceptions",
        "//props/core:ids",
        "//props/core:splits",
        "//props/core/models:examples",
        "//props/critic:exceptions",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:session",
        "@pypi//fastmcp",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

# =============================================================================
# CLI helpers
# =============================================================================

py_library(
    name = "cli_helpers",
    srcs = ["cli_helpers.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:agent_types",
        "//props/core:display",
        "//props/core:ids",
        "//props/db:models",
        "//props/db:session",
        "@pypi//rich",
        "@pypi//sqlalchemy",
    ],
)

# =============================================================================
# CLI entry point (standalone, for in-container use)
# =============================================================================

py_library(
    name = "cli_lib",
    srcs = ["cli.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":cli_helpers",
        ":prompt_eval_server",
        "//agent_pkg/runtime",
        "//cli_util",
        "//props/core:agent_helpers",
        "//props/core:agent_types",
        "//props/core:display",
        "//props/core:splits",
        "//props/core/cli:cmd_stats",
        "//props/core/models:examples",
        "//props/db:session",
        "@pypi//rich",
        "@pypi//sqlalchemy",
        "@pypi//typer",
    ],
)

py_binary(
    name = "cli",
    srcs = ["cli.py"],
    main = "cli.py",
    visibility = ["//visibility:public"],
    deps = [":cli_lib"],
)
