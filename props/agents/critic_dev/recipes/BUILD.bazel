"""Recipes: tested examples of common critic-dev workflows.

Bundled into critic-dev OCI images so agents can import or inspect them.
"""

load("@rules_python//python:defs.bzl", "py_library")
load("//tools/testing:defs.bzl", "py_test")

exports_files(["build_critic.sh"])

py_library(
    name = "ground_truth",
    srcs = ["ground_truth.py"],
    imports = ["../../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/core:splits",
        "//props/db:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "recall_metrics",
    srcs = ["recall_metrics.py"],
    imports = ["../../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:splits",
        "//props/db:models",
        "//props/db:query_builders",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "run_analysis",
    srcs = ["run_analysis.py"],
    imports = ["../../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:agent_types",
        "//props/core:ids",
        "//props/db:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
