"""Agent runtime libraries shared across all in-container agents."""

load("@rules_python//python:defs.bzl", "py_library")

# NOTE: No aggregator target - use specific per-file targets like :runtime, :eval_client
# This is the Gazelle-compatible pattern (python_generation_mode = file)

py_library(
    name = "schema",
    srcs = ["schema.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:models",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":schema",
        "//openai_utils:model",
        "//props/db:database",
        "//props/db:models",
        "//props/db:queries",
        "//props/db:snapshot_io",
        "@pypi//jinja2",
        "@pypi//openai",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "eval_client",
    srcs = ["eval_client.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":runtime",
        "//props/core:eval_api_models",
        "//props/core:ids",
        "//props/core/models:examples",
        "//props/db:database",
        "//props/db:examples",
        "//props/db:models",
        "@pypi//httpx",
        "@pypi//sqlalchemy",
    ],
)
