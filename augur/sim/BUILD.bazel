load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = [
        "@pypi//polars",
    ],
)

py_library(
    name = "state",
    srcs = ["state.py"],
    deps = [
        ":frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        ":frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "market",
    srcs = ["market.py"],
    deps = [
        ":frames",
        "//augur/model:sim_market_py",
        "@pypi//polars",
    ],
)

filegroup(
    name = "jurisdiction_data",
    srcs = glob(["data/jurisdictions/*.yaml"]),
)

filegroup(
    name = "location_data",
    srcs = glob(["data/locations/*.yaml"]),
)

py_library(
    name = "locations",
    srcs = ["locations.py"],
    data = [":location_data"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "locations_test",
    srcs = ["locations_test.py"],
    deps = [
        ":locations",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "jurisdictions",
    srcs = ["jurisdictions.py"],
    data = [":jurisdiction_data"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "jurisdictions_test",
    srcs = ["jurisdictions_test.py"],
    deps = [
        ":jurisdictions",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "tax",
    srcs = ["tax.py"],
    deps = [
        ":jurisdictions",
        "@pypi//numpy",
    ],
)

py_test(
    name = "tax_test",
    srcs = ["tax_test.py"],
    deps = [
        ":jurisdictions",
        ":tax",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "scenario",
    srcs = ["scenario.py"],
    deps = [
        "//augur/model:sim_market_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "apply",
    srcs = ["apply.py"],
    deps = [
        ":events",
        ":state",
        "@pypi//polars",
    ],
)

py_library(
    name = "liquidity",
    srcs = ["liquidity.py"],
    deps = [
        ":events",
        ":frames",
        ":market",
        ":scenario",
        ":state",
        "@pypi//polars",
    ],
)

py_library(
    name = "obligations",
    srcs = ["obligations.py"],
    deps = [
        ":events",
        ":locations",
        ":scenario",
        ":state",
        "@pypi//polars",
    ],
)

py_library(
    name = "settlement",
    srcs = ["settlement.py"],
    deps = [
        ":events",
        ":liquidity",
        ":state",
        "@pypi//polars",
    ],
)

py_library(
    name = "step",
    srcs = ["step.py"],
    deps = [
        ":events",
        ":frames",
        ":jurisdictions",
        ":liquidity",
        ":locations",
        ":market",
        ":obligations",
        ":scenario",
        ":settlement",
        ":state",
        ":tax",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "run",
    srcs = ["run.py"],
    deps = [
        ":events",
        "@pypi//polars",
    ],
)

py_library(
    name = "projections",
    srcs = ["projections.py"],
    deps = [
        ":frames",
        ":run",
        "@pypi//polars",
    ],
)

py_library(
    name = "simulate",
    srcs = ["simulate.py"],
    deps = [
        ":apply",
        ":events",
        ":jurisdictions",
        ":locations",
        ":market",
        ":run",
        ":scenario",
        ":state",
        ":step",
        "@pypi//polars",
    ],
)

py_library(
    name = "replay",
    srcs = ["replay.py"],
    deps = [
        ":apply",
        ":run",
        ":scenario",
        ":simulate",
        ":state",
        "@pypi//polars",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//augur/model:sim_market_deterministic_py",
        "//augur/model:sim_market_py",
        "@pypi//pytest",
    ],
)

py_test(
    name = "simulate_test",
    srcs = ["simulate_test.py"],
    deps = [
        ":conftest",
        ":market",
        ":replay",
        ":scenario",
        ":simulate",
        "//augur/model:sim_market_gbm_py",
        "//augur/model:sim_market_py",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "projections_test",
    srcs = ["projections_test.py"],
    deps = [
        ":conftest",
        ":projections",
        ":scenario",
        ":simulate",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "bench_scenario",
    srcs = ["bench_scenario.py"],
    deps = [
        ":scenario",
        "//augur/model:sim_market_gbm_py",
        "//augur/model:sim_market_py",
    ],
)

py_binary(
    name = "bench",
    srcs = ["bench.py"],
    main_module = "augur.sim.bench",
    deps = [
        ":bench_scenario",
        ":simulate",
    ],
)

py_test(
    name = "bench_test",
    srcs = ["bench_test.py"],
    deps = [
        ":bench_scenario",
        ":scenario",
        ":simulate",
        "//augur/model:sim_market_deterministic_py",
        "//augur/model:sim_market_py",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
