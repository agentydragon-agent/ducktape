load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        "//augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":wire",
        "//augur/api:bootstrap",
        "//augur/api:config",
        "//augur/api:portfolio",
        "//augur/model:series",
        "//augur/sim:pricing",
        "//augur/sim:scenario",
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "decode",
    srcs = ["decode.py"],
    deps = [
        ":wire",
        "//augur/model:series",
        "//augur/sim:engine",
        "//augur/sim:scenario",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":decode",
        ":scenarios",
        ":wire",
        "//augur/api:bootstrap",
        "//augur/api:portfolio",
        "//augur/api:schemas",
        "//augur/model:exogenous",
        "//augur/sim:engine",
        "//augur/sim:external_series",
        "//augur/sim:simulate",
        "//augur/sim:slice",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "portfolio",
    srcs = ["portfolio.py"],
    deps = [
        "//augur/api:finance",
        "//augur/api:portfolio",
        "//augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "portfolio_test",
    srcs = ["portfolio_test.py"],
    deps = [
        ":portfolio",
        "//augur/api:finance",
        "//augur/api:portfolio",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "service_test",
    size = "medium",
    srcs = ["service_test.py"],
    data = [
        "//augur/api:public_fixture_config",
        "//augur/api:public_fixture_properties",
    ],
    deps = [
        ":decode",
        ":scenarios",
        ":service",
        ":wire",
        "//augur/api:catalog",
        "//augur/api:config",
        "//augur/model:exogenous",
        "//augur/model:series",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
