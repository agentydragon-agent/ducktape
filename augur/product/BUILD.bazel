load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "wire_py",
    srcs = ["wire.py"],
    deps = [
        "//augur/api:schemas_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "scenarios_py",
    srcs = ["scenarios.py"],
    deps = [
        ":wire_py",
        "//augur/api:config_py",
        "//augur/api:portfolio_py",
        "//augur/api:scenario_set_py",
        "//augur/model:series_py",
        "//augur/sim:scenario",
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "decode_py",
    srcs = ["decode.py"],
    deps = [
        ":wire_py",
        "//augur/sim:engine",
        "//augur/sim:run",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "service_py",
    srcs = ["service.py"],
    deps = [
        ":decode_py",
        ":scenarios_py",
        ":wire_py",
        "//augur/api:portfolio_py",
        "//augur/api:schemas_py",
        "//augur/model:exogenous_py",
        "//augur/sim:engine",
        "//augur/sim:external_series",
        "//augur/sim:simulate",
        "//augur/sim:slice",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "portfolio_py",
    srcs = ["portfolio.py"],
    deps = [
        "//augur/api:finance_py",
        "//augur/api:portfolio_py",
        "//augur/api:schemas_py",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "portfolio_test",
    srcs = ["portfolio_test.py"],
    deps = [
        ":portfolio_py",
        "//augur/api:finance_py",
        "//augur/api:portfolio_py",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "service_test",
    size = "medium",
    srcs = ["service_test.py"],
    data = ["//augur/api:public_fixture_config"],
    deps = [
        ":decode_py",
        ":scenarios_py",
        ":service_py",
        ":wire_py",
        "//augur/api:config_py",
        "//augur/model:exogenous_py",
        "//augur/model:series_py",
        "//augur/model:simple_exogenous_py",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
