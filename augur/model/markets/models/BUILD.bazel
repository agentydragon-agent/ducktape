load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "vecm_py",
    srcs = ["vecm.py"],
    deps = [
        "//augur:frames",
        "//augur/core:market_bundle_py",
        "//augur/core:provenance_py",
        "//augur/core:schemas_py",
        "//augur/model:core_market_adapter_py",
        "//augur/model:location_market_sources_py",
        "//augur/model:sim_market_api_py",
        "//augur/model:sim_market_series_py",
        "//augur/model/markets:density_py",
        "//augur/model/markets:scenarios_py",
        "@pypi//numpy",
        "@pypi//pydantic",
        "@pypi//statsmodels",
    ],
)

py_test(
    name = "vecm_test",
    srcs = ["vecm_test.py"],
    deps = [
        ":vecm_py",
        "//augur/model/markets:scenarios_py",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
