load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "vecm",
    srcs = ["vecm.py"],
    data = ["//augur/fit/calibrated:trained_vecm_blob"],
    deps = [
        "//augur:frames",
        "//augur/model:exogenous",
        "//augur/model:location_series_sources",
        "//augur/model:provenance",
        "//augur/model:schemas",
        "//augur/model:series",
        "//augur/model/path_models:scenarios",
        "//util/bazel:runfiles",
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "vecm_test",
    size = "large",
    srcs = ["vecm_test.py"],
    deps = [
        ":vecm",
        "//augur/model:exogenous",
        "//augur/model:location_series_sources",
        "//augur/model:series",
        "//augur/model/path_models:scenarios",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pytest_bazel",
    ],
)
