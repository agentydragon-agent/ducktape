package(default_visibility = ["//visibility:public"])

# Shared market/source config used by the rollout providers and
# metrics harness. The data CSVs underneath `source/` are public and
# refreshed per the recipes in source/SOURCES.md.
filegroup(
    name = "market_config_files",
    srcs = [
        "market_config.example.json",
    ] + glob([
        "source/**/*.csv",
        "source/**/*.json",
        "source/**/*.md",
    ]),
)
