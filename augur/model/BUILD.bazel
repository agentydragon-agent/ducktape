load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "schemas",
    srcs = ["schemas.py"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "provenance",
    srcs = ["provenance.py"],
)

py_library(
    name = "location_series_sources",
    srcs = ["location_series_sources.py"],
    deps = [
        ":schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "exogenous",
    srcs = ["exogenous.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "series",
    srcs = ["series.py"],
)

py_library(
    name = "deterministic",
    srcs = ["deterministic.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "gbm",
    srcs = ["gbm.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "poisson_events",
    srcs = ["poisson_events.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "series_model",
    srcs = ["series_model.py"],
    deps = [
        ":deterministic",
        ":exogenous",
        ":gbm",
        ":poisson_events",
        "//augur:frames",
        "@pypi//polars",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "independent_exogenous",
    srcs = ["independent_exogenous.py"],
    deps = [
        ":deterministic",
        ":exogenous",
        ":gbm",
        ":schemas",
        ":series",
        ":series_model",
        "//augur/model/path_models:scenarios",
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "exogenous_provider_config",
    srcs = ["exogenous_provider_config.py"],
    deps = [
        ":independent_exogenous",
        "//augur/model/path_models/models:vecm",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        ":deterministic",
        ":exogenous",
        ":series_model",
        "//augur:frames",
        "@pypi//numpy",
    ],
)

py_test(
    name = "series_model_test",
    srcs = ["series_model_test.py"],
    deps = [
        ":deterministic",
        ":exogenous",
        ":gbm",
        ":series",
        ":series_model",
        ":testing",
        "@pypi//numpy",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "independent_exogenous_test",
    srcs = ["independent_exogenous_test.py"],
    deps = [
        ":exogenous",
        ":exogenous_provider_config",
        ":independent_exogenous",
        ":series",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "private_equity_trajectories",
    srcs = ["private_equity_trajectories.py"],
    deps = [
        ":exogenous",
        ":series",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_test(
    name = "private_equity_trajectories_test",
    srcs = ["private_equity_trajectories_test.py"],
    deps = [
        ":exogenous",
        ":private_equity_trajectories",
        ":series",
        "@pypi//numpy",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
