load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "location_market_sources_py",
    srcs = ["location_market_sources.py"],
    deps = [
        "//augur/core:schemas_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "market_api_py",
    srcs = ["market_api.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "series_py",
    srcs = ["series.py"],
)

py_library(
    name = "deterministic_py",
    srcs = ["deterministic.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "gbm_py",
    srcs = ["gbm.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "market_py",
    srcs = ["market.py"],
    deps = [
        ":deterministic_py",
        ":gbm_py",
        ":market_api_py",
        "//augur:frames",
        "@pypi//polars",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "simple_market_py",
    srcs = ["simple_market.py"],
    deps = [
        ":deterministic_py",
        ":gbm_py",
        ":market_api_py",
        ":market_py",
        ":series_py",
        "//augur:frames",
        "//augur/core:schemas_py",
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "market_provider_config_py",
    srcs = ["market_provider_config.py"],
    deps = [
        ":simple_market_py",
        "//augur/core:schemas_py",
        "//augur/model/markets/models:vecm_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "testing_py",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        ":deterministic_py",
        ":market_api_py",
        ":market_py",
        "//augur:frames",
        "@pypi//numpy",
    ],
)

py_test(
    name = "market_test",
    srcs = ["market_test.py"],
    deps = [
        ":deterministic_py",
        ":gbm_py",
        ":market_api_py",
        ":market_py",
        ":series_py",
        ":testing_py",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "simple_market_test",
    srcs = ["simple_market_test.py"],
    deps = [
        ":market_api_py",
        ":market_provider_config_py",
        ":series_py",
        ":simple_market_py",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)
