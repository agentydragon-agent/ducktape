load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "market_data_py",
    srcs = ["market_data.py"],
    deps = [
        ":market_config_py",
        "@pypi//numpy",
        "@pypi//pandas",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "location_market_sources_py",
    srcs = ["location_market_sources.py"],
    deps = [
        "//augur/core:schemas_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sim_market_api_py",
    srcs = ["sim_market_api.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "sim_market_deterministic_py",
    srcs = ["sim_market_deterministic.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sim_market_gbm_py",
    srcs = ["sim_market_gbm.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sim_market_py",
    srcs = ["sim_market.py"],
    deps = [
        ":sim_market_api_py",
        ":sim_market_deterministic_py",
        ":sim_market_gbm_py",
        "@pypi//polars",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "market_config_py",
    srcs = ["market_config.py"],
    deps = [
        ":location_market_sources_py",
        "//augur/core:schemas_py",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_library(
    name = "macro_market_bundle_provider_py",
    srcs = ["macro_market_bundle_provider.py"],
    deps = [
        ":location_market_sources_py",
        "//augur/core:market_bundle_py",
        "//augur/core:provenance_py",
        "//augur/core:scenario_set_py",
        "//augur/model/markets:market_model_py",
        "@pypi//numpy",
    ],
)

py_binary(
    name = "metrics_report",
    srcs = ["metrics_report.py"],
    data = ["//augur/model/config:market_config_files"],
    deps = [
        "//augur/model/markets:data_py",
        "//augur/model/markets:metrics_py",
        "//augur/model/markets:registry_py",
    ],
)

py_library(
    name = "market_provider_config_py",
    srcs = ["market_provider_config.py"],
    deps = [
        "//augur/core:market_bundle_py",
        "//augur/core:schemas_py",
        "//augur/model/markets/models:bootstrap_py",
        "//augur/model/markets/models:dcc_garch_py",
        "//augur/model/markets/models:var_py",
        "//augur/model/markets/models:vecm_py",
        "//augur/model/markets/models:wilkie_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "train_lib",
    srcs = ["train.py"],
    data = ["//augur/model/config:market_config_files"],
    deps = [
        ":market_config_py",
        ":market_provider_config_py",
        "//augur/model/markets:data_py",
        "//augur/model/markets:registry_py",
        "//augur/model/markets/models:bootstrap_py",
        "//augur/model/markets/models:dcc_garch_py",
        "//augur/model/markets/models:var_py",
        "//augur/model/markets/models:vecm_py",
        "//augur/model/markets/models:wilkie_py",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "train",
    main_module = "augur.model.train",
    deps = [":train_lib"],
)

py_test(
    name = "train_round_trip_test",
    size = "large",
    srcs = ["train_round_trip_test.py"],
    deps = [
        ":market_provider_config_py",
        ":train_lib",
        "//augur/core:market_bundle_py",
        "//augur/core:scenario_set_py",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "market_config_test",
    srcs = ["market_config_test.py"],
    data = ["//augur/model/config:market_config_files"],
    deps = [
        ":market_config_py",
        "//augur/core:schemas_py",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "macro_market_bundle_provider_test",
    srcs = ["macro_market_bundle_provider_test.py"],
    deps = [
        ":location_market_sources_py",
        ":macro_market_bundle_provider_py",
        "//augur/core:market_bundle_py",
        "//augur/core:scenario_set_py",
        "//augur/model/markets:scenarios_py",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "sim_market_test",
    srcs = ["sim_market_test.py"],
    deps = [
        ":sim_market_api_py",
        ":sim_market_deterministic_py",
        ":sim_market_gbm_py",
        ":sim_market_py",
        "@pypi//polars",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
