load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "evidence_config_files",
    srcs = [
        "//augur/data:evidence_source_files",
        "//augur/fit/config:exogenous_evidence_config",
    ],
)

py_library(
    name = "evidence_config",
    srcs = ["evidence_config.py"],
    deps = [
        "//augur/model:location_series_sources",
        "//augur/model:schemas",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_library(
    name = "evidence_data",
    srcs = ["evidence_data.py"],
    deps = [
        ":evidence_config",
        "@pypi//numpy",
        "@pypi//pandas",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "exogenous_model",
    srcs = ["exogenous_model.py"],
    deps = [
        "//augur/model/path_models:scenarios",
    ],
)

py_library(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [
        ":exogenous_model",
        "//augur/model/path_models:scenarios",
    ],
)

py_library(
    name = "data",
    srcs = ["data.py"],
    data = [":evidence_config_files"],
    deps = [
        ":evidence_config",
        ":evidence_data",
        "//augur/model:location_series_sources",
        "//augur/model/path_models:scenarios",
        "@pypi//numpy",
        "@pypi//pandas",
    ],
)

py_binary(
    name = "metrics_report",
    srcs = ["metrics_report.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data",
        ":exogenous_model",
        ":metrics",
        "//augur/model/path_models/models:vecm",
    ],
)

py_library(
    name = "train_lib",
    srcs = ["main.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data",
        ":evidence_config",
        "//augur/model:exogenous_provider_config",
        "//augur/model/path_models/models:vecm",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "train",
    main_module = "augur.fit.main",
    deps = [":train_lib"],
)

py_test(
    name = "evidence_config_test",
    srcs = ["evidence_config_test.py"],
    data = [":evidence_config_files"],
    deps = [
        ":evidence_config",
        "//augur/model:schemas",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "data_test",
    srcs = ["data_test.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data",
        ":evidence_config",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    deps = [
        ":exogenous_model",
        ":metrics",
        "//augur/model/path_models:scenarios",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "train_round_trip_test",
    size = "large",
    srcs = ["train_round_trip_test.py"],
    deps = [
        ":train_lib",
        "//augur/model:exogenous",
        "//augur/model:exogenous_provider_config",
        "//augur/model:independent_exogenous",
        "//augur/model:series",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
