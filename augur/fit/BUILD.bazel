load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "evidence_config_files",
    srcs = [
        "//augur/data:evidence_source_files",
        "//augur/model/train/config:exogenous_evidence_config",
    ],
)

py_library(
    name = "evidence_config_py",
    srcs = ["evidence_config.py"],
    deps = [
        "//augur/model:location_series_sources_py",
        "//augur/model:schemas_py",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_library(
    name = "evidence_data_py",
    srcs = ["evidence_data.py"],
    deps = [
        ":evidence_config_py",
        "@pypi//numpy",
        "@pypi//pandas",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "exogenous_model_py",
    srcs = ["exogenous_model.py"],
    deps = [
        "//augur/model/path_models:scenarios_py",
    ],
)

py_library(
    name = "metrics_py",
    srcs = ["metrics.py"],
    deps = [
        ":exogenous_model_py",
        "//augur/model/path_models:scenarios_py",
    ],
)

py_library(
    name = "data_py",
    srcs = ["data.py"],
    data = [":evidence_config_files"],
    deps = [
        ":evidence_config_py",
        ":evidence_data_py",
        "//augur/model:location_series_sources_py",
        "//augur/model/path_models:scenarios_py",
        "@pypi//numpy",
        "@pypi//pandas",
    ],
)

py_binary(
    name = "metrics_report",
    srcs = ["metrics_report.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data_py",
        ":exogenous_model_py",
        ":metrics_py",
        "//augur/model/path_models/models:vecm_py",
    ],
)

py_library(
    name = "train_lib",
    srcs = ["main.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data_py",
        ":evidence_config_py",
        "//augur/model:exogenous_provider_config_py",
        "//augur/model/path_models/models:vecm_py",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "train",
    main_module = "augur.fit.main",
    deps = [":train_lib"],
)

py_test(
    name = "evidence_config_test",
    srcs = ["evidence_config_test.py"],
    data = [":evidence_config_files"],
    deps = [
        ":evidence_config_py",
        "//augur/model:schemas_py",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "data_test",
    srcs = ["data_test.py"],
    data = [":evidence_config_files"],
    deps = [
        ":data_py",
        ":evidence_config_py",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    deps = [
        ":exogenous_model_py",
        ":metrics_py",
        "//augur/model/path_models:scenarios_py",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "train_round_trip_test",
    size = "large",
    srcs = ["train_round_trip_test.py"],
    deps = [
        ":train_lib",
        "//augur/model:exogenous_provider_config_py",
        "//augur/model:exogenous_py",
        "//augur/model:series_py",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
