load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "config_py",
    srcs = ["config.py"],
    deps = [
        ":portfolio_py",
        "//augur/core:bootstrap_py",
        "//augur/core:local_regulation_py",
        "//augur/core:scenario_set_py",
        "//augur/core:schemas_py",
        "//augur/model:market_provider_config_py",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "config_test",
    srcs = ["config_test.py"],
    deps = [
        ":config_py",
        ":portfolio_py",
        "//augur/core:local_regulation_py",
        "//augur/core:scenario_set_py",
        "//augur/model:market_provider_config_py",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "portfolio_py",
    srcs = ["portfolio.py"],
    deps = [
        "//augur/sim:scenario",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "portfolio_test",
