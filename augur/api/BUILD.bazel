py_test(
    name = "sim_backend_test",
    srcs = ["sim_backend_test.py"],
    data = [
        ":public_fixture_config",
        ":public_fixture_properties",
    ],
    deps = [
        ":backend_py",
        ":config_py",
        "//augur/core:casing_py",
        "//augur/core:market_bundle_py",
        "//augur/core:scenario_set_py",
        "//augur/model:simple_market_py",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
