    deps = [
        ":portfolio_py",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "catalog_py",
    srcs = ["catalog.py"],
    deps = [
        ":config_py",
        "//augur/core:bootstrap_py",
        "//augur/core:local_regulation_py",
        "//augur/core:scenario_set_py",
        "//augur/core:schemas_py",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_test(
    name = "catalog_test",
    srcs = ["catalog_test.py"],
    deps = [
        ":backend_py",
        ":catalog_py",
        ":config_py",
        "//augur/core:local_regulation_py",
        "//augur/core:market_bundle_py",
        "//augur/core:scenario_set_py",
        "//augur/model:market_provider_config_py",
        "//augur/model:testing_py",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "backend_py",
    srcs = ["backend.py"],
    deps = [
        ":catalog_py",
        ":config_py",
        ":sim_bridge_py",
        ":sim_response_py",
        "//augur/core:api_py",
        "//augur/core:bootstrap_py",
        "//augur/core:market_bundle_py",
        "//augur/core:scenario_engine_py",
        "//augur/core:scenario_set_py",
        "//augur/core:scenario_tax_defaults_py",
        "//augur/core:schemas_py",
        "//augur/model:sim_market_api_py",
        "//augur/sim:market",
        "//augur/sim:simulate",
    ],
)

py_library(
    name = "http_server_py",
    srcs = ["http_server.py"],
    deps = [
        ":backend_py",
        ":config_py",
        "//augur/core:backend_py",
        "//augur/core:market_bundle_py",
        "//augur/model:market_provider_config_py",
        "//augur/model:sim_market_api_py",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "sim_bridge_py",
    srcs = ["sim_bridge.py"],
    deps = [
        "//augur/core:scenario_set_py",
        "//augur/model:sim_market_api_py",
        "//augur/model:sim_market_series_py",
        "//augur/sim:market",
        "//augur/sim:run",
        "//augur/sim:scenario",
        "//augur/sim:simulate",
        "@pypi//numpy",
    ],
)

py_library(
    name = "sim_response_py",
    srcs = ["sim_response.py"],
    deps = [
        "//augur/core:scenario_set_py",
        "//augur/core:schemas_py",
        "//augur/model:sim_market_series_py",
        "//augur/sim:run",
