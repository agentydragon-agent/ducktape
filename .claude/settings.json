    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bazel build:*)",
      "Bash(bazel info:*)",
      "Bash(bazel mod:*)",
      "Bash(bazel query:*)",
      "Bash(bazel run @bazel_gazelle//cmd/gazelle:*)",
      "Bash(bazel test:*)",
      "Bash(dconf dump:*)",
      "Bash(dconf read:*)",
      "Bash(flux reconcile:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(gnome-extensions list:*)",
      "Bash(gsettings get:*)",
      "Bash(gsettings list-recursively:*)",
      "Bash(gsettings list-schemas:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl get job:*)",
      "Bash(kubectl get pod:*)",
      "Bash(kubectl get pods:*)",
      "Bash(kubectl get terraform:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl top:*)",
      "Bash(modinfo:*)",
      "Bash(nix search:*)",
      "Bash(ping:*)",
      "Bash(pre-commit run:*)",
      "WebFetch(domain:docs.attic.rs)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  }
}
