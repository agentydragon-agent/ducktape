load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/deps:check.bzl", "assert_no_deps")

# Minimal subprocess execution - no MCP/fastmcp or openai API deps
# Used by in-container agent loops that need exec without the MCP server overhead
py_library(
    name = "subprocess_exec",
    srcs = [
        "models.py",
        "subprocess_exec.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils:strict_mode",
        "@pypi//pydantic",
    ],
)

# Verifies subprocess_exec has no fastmcp/mcp dependency (critical for in-container use)
assert_no_deps(
    name = "test_subprocess_exec_no_mcp",
    target = "//mcp_infra/exec:subprocess_exec",
    forbidden_pattern = "@pypi//fastmcp|@pypi//mcp",
)

# Image reading utility (shared by direct, seatbelt, bwrap, docker)
py_library(
    name = "read_image",
    srcs = ["read_image.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils",
        "@pypi//mcp",
    ],
)

# Direct (unsandboxed) exec MCP server
py_library(
    name = "direct",
    srcs = ["direct.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# macOS seatbelt sandbox exec MCP server
py_library(
    name = "seatbelt",
    srcs = ["seatbelt.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "//mcp_infra/seatbelt",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# Linux bubblewrap sandbox exec MCP server
py_library(
    name = "bwrap",
    srcs = ["bwrap.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# Docker container exec MCP server
py_library(
    name = "docker",
    srcs = [
        "docker/container_session.py",
        "docker/launcher.py",
        "docker/server.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//cli_util",
        "//mcp_infra",
        "//mcp_infra/enhanced",
        "@pypi//aiodocker",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//typer_di",
    ],
)

