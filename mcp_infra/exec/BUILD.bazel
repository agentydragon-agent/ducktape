load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Minimal subprocess execution - no MCP/fastmcp deps
# Used by in-container agent loops that need exec without the MCP server overhead
py_library(
    name = "subprocess_exec",
    srcs = [
        "models.py",
        "subprocess.py",
        "subprocess_exec.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "exec",
    srcs = [
        "__init__.py",
        "bwrap.py",
        "container_session.py",
        "direct.py",
        "docker/__init__.py",
        "docker/launcher.py",
        "docker/server.py",
        "read_image.py",
        "seatbelt.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":subprocess_exec",
        "//cli_util",
        "//mcp_infra",
        "//mcp_infra/enhanced",
        "//mcp_infra/seatbelt",
        "@pypi//aiodocker",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//typer_di",
    ],
)

py_test(
    name = "test_exec",
    srcs = [
        "test_bwrap.py",
        "test_direct.py",
        "test_docker.py",
        "test_docker_unit.py",
        "test_seatbelt.py",
    ],
    main = "test_direct.py",
    deps = [
        ":exec",
        "//mcp_infra:test_support",
        "@pypi//docker",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//types_docker",
    ],
)
