load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Minimal subprocess execution - no MCP/fastmcp deps
# Used by in-container agent loops that need exec without the MCP server overhead
py_library(
    name = "subprocess_exec",
    srcs = [
        "models.py",
        "subprocess.py",
        "subprocess_exec.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils",
        "@pypi//pydantic",
    ],
)

# Image reading utility (shared by direct, seatbelt, bwrap, docker)
py_library(
    name = "read_image",
    srcs = ["read_image.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils",
        "@pypi//mcp",
    ],
)

# Direct (unsandboxed) exec MCP server
py_library(
    name = "direct",
    srcs = ["direct.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# macOS seatbelt sandbox exec MCP server
py_library(
    name = "seatbelt",
    srcs = ["seatbelt.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "//mcp_infra/seatbelt",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# Linux bubblewrap sandbox exec MCP server
py_library(
    name = "bwrap",
    srcs = ["bwrap.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//mcp_infra/enhanced",
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
)

# Docker container exec MCP server
py_library(
    name = "docker",
    srcs = [
        "container_session.py",
        "docker/__init__.py",
        "docker/launcher.py",
        "docker/server.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":read_image",
        ":subprocess_exec",
        "//cli_util",
        "//mcp_infra",
        "//mcp_infra/enhanced",
        "@pypi//aiodocker",
        "@pypi//anyio",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//typer_di",
    ],
)

# Convenience target that re-exports all exec servers
py_library(
    name = "exec",
    srcs = ["__init__.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":bwrap",
        ":direct",
        ":docker",
        ":seatbelt",
    ],
)

py_test(
    name = "test_direct",
    srcs = ["test_direct.py"],
    deps = [
        ":direct",
        "//mcp_infra:test_support",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_seatbelt",
    srcs = ["test_seatbelt.py"],
    deps = [
        ":seatbelt",
        "//mcp_infra:test_support",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_bwrap",
    srcs = ["test_bwrap.py"],
    deps = [
        ":bwrap",
        "//mcp_infra:test_support",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_docker",
    srcs = [
        "test_docker.py",
        "test_docker_unit.py",
    ],
    main = "test_docker.py",
    deps = [
        ":docker",
        "//mcp_infra:test_support",
        "@pypi//docker",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//types_docker",
    ],
)
