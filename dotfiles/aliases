alias ..='cd ..'
alias suspend='systemctl suspend'

# Quickly create a GitLab merge request
# "git merge request create"
alias gmrc='glab mr create --fill --remove-source-branch --yes'

# "git ReCent Branches"
# TODO: slightly nicer version at https://stackoverflow.com/a/5188364 also
# has colors, human-readable dates, authors, ahead/behind against master
alias grcb='git for-each-ref --sort=-committerdate'

function bmosh() {
  # Use like: bmosh root@agentydragon.com
  mosh $1 -- tmux new-session -A -s bmosh
}

alias vimdiff='nvim -d'

