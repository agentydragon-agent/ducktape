[user]
	name = Rai
	email = agentydragon@gmail.com
[core]
	autocrlf = false
    excludesFile = ~/.config/git/gitignore-global
[color]
	ui = auto
[push]
	default = upstream
[log]
	abbrevCommit = true
	decorate = short
	date = local
[format]
	pretty = short
[advice]
	pushNonFastForwards = false
	statusHints = false
	commitBeforeMerge = false
[clean]
	requireForce = true
[branch]
	autosetuprebase = always
[rerere]
	enabled = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[init]
	defaultBranch = main
[difftool "nbdime"]
	cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"
[difftool]
	prompt = false
[mergetool "nbdime"]
	cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[mergetool]
	prompt = false
[merge]
	tool = vimdiff
