#!/usr/bin/env python3
"""Triggers color scheme update on running Neovim instances."""

from pathlib import Path

from pynvim import attach

# TODO: should probably only try to do this to *my* neovim instances
for dir in Path("/tmp").glob("nvim*"):
    socket = dir / "0"
    nvim = attach("socket", path=socket)
    nvim.command("lua UpdateThemeFromGnome()")
