#!/usr/bin/env bash

# Workaround attempt for missing / not working apply_patch in Codex.

# stdin → unified diff; args → extra flags for git-apply / patch
set -euo pipefail
if command -v git &>/dev/null; then           # prefer git if available
  exec git apply --whitespace=nowarn "$@" -
else                                          # fallback to POSIX patch
  exec patch -p1 -N -u "$@"
fi
EOF
