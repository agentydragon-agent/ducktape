#!/usr/bin/env python3
"""
Generate Docker-style friendly names for agents.
Similar to how Docker names containers like "friendly_einstein" or "brave_curie".
"""

import random
import sys

adjectives = [
    "brave",
    "bright",
    "calm",
    "clever",
    "cool",
    "eager",
    "fair",
    "fast",
    "gentle",
    "happy",
    "jolly",
    "keen",
    "kind",
    "lively",
    "merry",
    "nice",
    "proud",
    "quick",
    "sharp",
    "smart",
    "swift",
    "wise",
    "witty",
    "zen",
]

animals = [
    "ant",
    "bat",
    "bear",
    "bee",
    "bird",
    "cat",
    "cod",
    "cow",
    "crab",
    "crow",
    "deer",
    "dog",
    "dove",
    "duck",
    "eagle",
    "eel",
    "elk",
    "emu",
    "fish",
    "fox",
    "frog",
    "goat",
    "hawk",
    "hen",
    "jay",
    "kiwi",
    "lamb",
    "lion",
    "lynx",
    "mole",
    "moth",
    "mouse",
    "newt",
    "otter",
    "owl",
    "ox",
    "pig",
    "puma",
    "rat",
    "raven",
    "seal",
    "shark",
    "sheep",
    "slug",
    "swan",
    "toad",
    "trout",
    "wasp",
    "wolf",
    "yak",
]

scientists = [
    "curie",
    "darwin",
    "einstein",
    "galileo",
    "hawking",
    "newton",
    "tesla",
    "turing",
    "lovelace",
    "hopper",
    "euler",
    "gauss",
    "fermi",
    "bohr",
    "heisenberg",
    "planck",
    "schrodinger",
    "feynman",
    "sagan",
    "goodall",
]


def generate_name(style="animal"):
    """Generate a friendly name in the specified style."""
    adjective = random.choice(adjectives)

    noun = random.choice(scientists) if style == "scientist" else random.choice(animals)

    return f"{adjective}_{noun}"


if __name__ == "__main__":
    style = sys.argv[1] if len(sys.argv) > 1 else "animal"
    print(generate_name(style))
