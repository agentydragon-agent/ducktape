# ~/.bashrc - Bash interactive shell configuration  
# For: bash-specific settings, prompt, completions. Sources ~/.shellrc for common config
# See: ~/code/ducktape/dotfiles/docs/shell-configuration.md

# Source shell-agnostic interactive configuration (includes profile)
. ~/.shellrc

# ==============================================================================
# HISTORY
# ==============================================================================

# Don't put duplicate lines or lines starting with space in the history
HISTCONTROL=ignoreboth

# Append to the history file, don't overwrite it
shopt -s histappend

# Very large history
HISTSIZE=10000000
HISTFILESIZE=10000000

# ==============================================================================
# SHELL OPTIONS
# ==============================================================================

# Check window size after each command and update LINES and COLUMNS if necessary
shopt -s checkwinsize

# Pattern "**" matches all files and zero or more directories/subdirectories
shopt -s globstar

# Disable flow control (Ctrl-S / Q) - pretty much useless
stty -ixon

# ==============================================================================
# PROMPT
# ==============================================================================

# Set variable identifying the chroot you work in (used in the prompt)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Detect color support
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# Uncomment to force colored prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

# Set prompt based on color support
if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# Set xterm title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# Alternative prompt function (currently unused)
set_ps1() {
	local PROMPT_COLOR='\[\033[01;32m\]'
	if [[ $EUID -eq 0 ]]; then
		local PROMPT_COLOR='\[\033[01;31m\]'
	fi

	# For servers:
	#PS1=$PROMPT_COLOR'\u@\h \w \[\033[01;34m\]$(my_git_ps1)\$\[\033[00m\] '
	#PS1=$PROMPT_COLOR'\u@\h \w \[\033[01;34m\]\$\[\033[00m\] '

	PS1=$PROMPT_COLOR'\w \[\033[01;34m\]\$\[\033[00m\] '
}

# ==============================================================================
# COMPLETIONS
# ==============================================================================

# Enable programmable completion features
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Custom completions
complete -cf sudo
complete -cf man

# Color support aliases (in bashrc instead of shellrc because oh-my-zsh handles this automatically for zsh)
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Colored manpage hack (in bashrc instead of shellrc because oh-my-zsh colored-man-pages plugin handles this for zsh)
man() {
    env \
        LESS_TERMCAP_mb=$(printf "\e[1;31m") \
        LESS_TERMCAP_md=$(printf "\e[1;31m") \
        LESS_TERMCAP_me=$(printf "\e[0m") \
        LESS_TERMCAP_se=$(printf "\e[0m") \
        LESS_TERMCAP_so=$(printf "\e[1;44;33m") \
        LESS_TERMCAP_ue=$(printf "\e[0m") \
        LESS_TERMCAP_us=$(printf "\e[1;32m") \
            man "$@"
}

# ==============================================================================
# CLAUDE LINTER INTEGRATION
# ==============================================================================

__claude_linter_preexec() {
    local cmd="$1"

    [[ -z "$cmd" ]] && return
    [[ "$cmd" =~ claude-linter ]] && return

    if ! claude-linter . >/dev/null 2>&1; then
        claude-linter . >&2
        echo "🛑 Command blocked due to Claude rule violations" >&2
        false
    fi
}

__claude_original_debug_trap=$(trap -p DEBUG | sed "s/^trap -- '\\(.*\\)' DEBUG$/\\1/")
claude_install_debug_trap() {
    if [ -n "$__claude_original_debug_trap" ]; then
        trap "__claude_linter_preexec \"\$BASH_COMMAND\" && ($__claude_original_debug_trap)" DEBUG
    else
        trap '__claude_linter_preexec "$BASH_COMMAND"' DEBUG
    fi
}

claude_linter_disable() {
    trap - DEBUG
    echo "Claude linter disabled for this session"
}

claude_linter_enable() {
    claude_install_debug_trap
    echo "Claude linter enabled"
}

# Enable for Claude Code and Codex
if [ "$CLAUDECODE" = "1" ] || [ "$CODEX_AGENT" = "1" ]; then
    claude_install_debug_trap
fi

# Initialize atuin for better shell history
eval "$(atuin init bash --disable-up-arrow)"
