[user]
	name = Rai
	email = agentydragon@gmail.com
[core]
	autocrlf = false
	excludesFile = ~/.gitignore-global
[color]
	ui = auto
[push]
	default = upstream
[log]
	abbrevCommit = true
	decorate = short
	date = local
[format]
	pretty = short
[advice]
	pushNonFastForwards = false
	statusHints = false
	commitBeforeMerge = false
[clean]
	requireForce = true
[branch]
	autosetuprebase = always
[rerere]
	enabled = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[init]
	defaultBranch = main
	templateDir = /home/agentydragon/.githooks/templates
[githooks]
	installDir = /home/agentydragon/.githooks
	cloneUrl = https://github.com/gabyx/githooks.git
	cloneBranch = main
	useCoreHooksPath = false
	runner = /home/agentydragon/.githooks/bin/runner
	dialog = /home/agentydragon/.githooks/bin/dialog
	autoUpdateEnabled = true
	maintainedHooks = all
	useManual = false
	autoUpdateCheckTimestamp = 1745367406
[alias]
	hooks = !\"/home/agentydragon/.githooks/bin/cli\"
[difftool "nbdime"]
	cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"
[difftool]
	prompt = false
[mergetool "nbdime"]
	cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[mergetool]
	prompt = false
[merge]
	tool = vimdiff
[githooks "autoupdate"]
	enabled = false
