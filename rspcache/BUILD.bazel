load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/lint:linters.bzl", "ruff_test")

exports_files(["pyproject.toml"])

py_library(
    name = "rspcache",
    srcs = glob(["src/rspcache/**/*.py"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils",
        "@pypi//asyncpg",
        "@pypi//canonicaljson",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//openai",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "rspcache_cli",
    srcs = ["src/rspcache/cli.py"],
    main = "src/rspcache/cli.py",
    deps = [":rspcache"],
)

ruff_test(
    name = "ruff",
    srcs = [":rspcache"],
)


# --- OCI Image ---

pkg_tar(
    name = "cli_tar",
    srcs = [":rspcache_cli"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

pkg_tar(
    name = "entrypoint_tar",
    srcs = ["entrypoint.sh"],
    package_dir = "/usr/local/bin",
    mode = "0755",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    tars = [
        ":cli_tar",
        ":entrypoint_tar",
    ],
    entrypoint = ["/usr/local/bin/entrypoint.sh"],
    cmd = ["run", "--app", "proxy", "--host", "0.0.0.0", "--port", "8000"],
    workdir = "/opt/adgn",
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    exposed_ports = ["8000/tcp", "8100/tcp"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["rspcache:latest"],
)
